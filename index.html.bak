      toast_connected: "Perangkat berhasil terhubung",
      toast_disconnected: "Perangkat terputus",
      toast_poll_set: "Polling rate diatur ke",
      toast_peak_on: "Performa Puncak diaktifkan",
      toast_peak_off: "Performa Puncak dinonaktifkan",
      toast_hp_on: "Mode Performa Tinggi diaktifkan",
      toast_hp_off: "Mode Hemat Daya diaktifkan",
      toast_debounce: "Debounce diatur ke",
      toast_toggle_on: "diaktifkan", toast_toggle_off: "dinonaktifkan",
      toast_profile: "Profil dialihkan ke",
      toast_err: "Perintah gagal",
      toast_no_webhid: "WebHID tidak tersedia. Gunakan Chrome/Edge via HTTPS atau localhost.",
      toast_no_device: "Tidak ada perangkat dipilih",
      toast_peak_dur: "Durasi puncak diatur ke",
    }
  };

  let currentLang = localStorage.getItem('aria2pro-lang') || 'en';

  function t(key) { return (LANG[currentLang] && LANG[currentLang][key]) || LANG.en[key] || key; }

  function applyLang() {
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.dataset.i18n;
      const val = t(key);
      if (val) el.innerHTML = val;
    });
    document.querySelectorAll('.lang-toggle').forEach(b => b.textContent = currentLang.toUpperCase());
    localStorage.setItem('aria2pro-lang', currentLang);
  }

  function toggleLang() {
    currentLang = currentLang === 'en' ? 'id' : 'en';
    applyLang();
  }

  document.getElementById('lang-toggle').addEventListener('click', toggleLang);
  document.getElementById('lang-toggle-2').addEventListener('click', toggleLang);

  // ─── Toast Notifications ──────────────────────
  function toast(msg, type = 'info') {
    const c = document.getElementById('toast-container');
    const d = document.createElement('div');
    d.className = 'toast toast-' + type;
    d.textContent = msg;
    c.appendChild(d);
    requestAnimationFrame(() => d.classList.add('show'));
    setTimeout(() => { d.classList.remove('show'); setTimeout(() => d.remove(), 400); }, 3000);
  }

  // ─── Protocol Engine ──────────────────────────
  const VID = 0x3554;
  const PID_WIRELESS = 0xF523;
  const PID_WIRED = 0xF5A5;
  const PACKET_SIZE = 17;
  const CHECKSUM_TARGET = 0x55;

  // Polling rate bit flags
  const POLL_MAP = { 0x01: 125, 0x02: 250, 0x04: 500, 0x08: 1000, 0x10: 2000, 0x20: 4000, 0x40: 8000 };
  const POLL_REVERSE = Object.fromEntries(Object.entries(POLL_MAP).map(([k,v]) => [v, parseInt(k)]));

  // Default hardware DPI stages decoded from official NVRAM memory block (0x000A - 0x002B)
  const DEFAULT_DPI_STAGES = [
    { stage: 1, dpi: 400, color: '#ff3333', raw: 0x07 },
    { stage: 2, dpi: 800, color: '#3388ff', raw: 0x0F },
    { stage: 3, dpi: 1600, color: '#00e879', raw: 0x1F },
    { stage: 4, dpi: 3200, color: '#ffd700', raw: 0x3F },
    { stage: 5, dpi: 3200, color: '#00e5ff', raw: 0x3F },
    { stage: 6, dpi: 6400, color: '#b044ff', raw: 0x7F },
  ];

  // Button mapping specifications
  const BUTTON_DEFS = {
    1: { name: 'Left Button', defaultAction: '0101', reg: null, locked: true },
    2: { name: 'Right Button', defaultAction: '0102', reg: 0x6404, locked: false },
    3: { name: 'Middle Button', defaultAction: '0104', reg: 0x6804, locked: false },
    4: { name: 'Forward', defaultAction: '0110', reg: 0x7004, locked: false },
    5: { name: 'Back', defaultAction: '0108', reg: 0x6C04, locked: false },
    6: { name: 'DPI Loop', defaultAction: '0500', reg: 0x7404, locked: false },
  };

  const ACTION_NAMES = {
    '0101': 'Left Click',
    '0102': 'Right Click',
    '0104': 'Middle Click',
    '0110': 'Forward',
    '0108': 'Back',
    '0500': 'DPI Loop',
    '0000': 'Disabled'
  };

  let hidDevice = null;
  let isCommandPending = false;

  let deviceState = {
    dpi: 1600,
    dpiStage: 2, // 0-indexed Stage 3 (1600 DPI)
    dpiStageCount: 6,
    dpiSource: 'default', // 'default' | 'applied'
    pollingRate: 1000,
    pollingByte: 0x08,
    peakPerformance: false,
    peakDuration: 3,
    hpMode: false,
    modeSelect: 'lp',
    savedHpMode: false,
    debounce: 5,
    sensorToggles: { 0xAB: false, 0xAF: false, 0xB1: false },
    sleepLod: 30,
    profile: 0,
    firmware: null,
    sensorId: null,
    battery: null,
    selectedButton: 1,
    buttonMapping: {
      1: '0101',
      2: '0102',
      3: '0104',
      4: '0110',
      5: '0108',
      6: '0500',
    }
  };

  function buildPacket(cmd, byte2 = 0, byte3 = 0, byte4 = 0, byte5 = 0, byte6 = 0, byte7 = null, extraBytes = []) {
    const pkt = new Uint8Array(PACKET_SIZE);
    pkt[0] = 0x08;
    pkt[1] = cmd;
    pkt[2] = byte2;
    pkt[3] = byte3;
    pkt[4] = byte4;
    pkt[5] = byte5;
    pkt[6] = byte6;
    pkt[7] = byte7 !== null ? byte7 : ((CHECKSUM_TARGET - byte6) & 0xFF);
    for (let i = 0; i < extraBytes.length && i + 8 < PACKET_SIZE - 1; i++) {
      pkt[8 + i] = extraBytes[i];
    }
    let sum = 0;
    for (let i = 0; i < PACKET_SIZE - 1; i++) sum += pkt[i];
    pkt[PACKET_SIZE - 1] = (CHECKSUM_TARGET - (sum & 0xFF)) & 0xFF;
    return pkt;
  }

  function buildSettingPacket(regHi, regLo, value) {
    return buildPacket(0x07, 0, 0, regHi, regLo, value);
  }

  function buildButtonPacket(reg, b1, b2, b3 = 0) {
    const pkt = new Uint8Array(PACKET_SIZE);
    pkt[0] = 0x08;
    pkt[1] = 0x07;
    pkt[2] = 0x00;
    pkt[3] = 0x00;
    pkt[4] = (reg >> 8) & 0xFF;
    pkt[5] = reg & 0xFF;
    pkt[6] = b1;
    pkt[7] = b2;
    pkt[8] = b3;
    pkt[9] = (CHECKSUM_TARGET - (b1 + b2 + b3)) & 0xFF;
    for (let i = 10; i < PACKET_SIZE - 1; i++) {
      pkt[i] = 0x00;
    }
    let sum = 0;
    for (let i = 0; i < PACKET_SIZE - 1; i++) sum += pkt[i];
    pkt[PACKET_SIZE - 1] = (CHECKSUM_TARGET - (sum & 0xFF)) & 0xFF;
    return pkt;
  }

  async function sendAndReceive(packet) {
    if (!hidDevice || !hidDevice.opened) throw new Error('Device not connected');
    const reportId = packet[0];
    const data = packet.slice(1);
    await hidDevice.sendReport(reportId, data);

    return new Promise((resolve, reject) => {
      const timeout = setTimeout(() => {
        hidDevice.removeEventListener('inputreport', handler);
        reject(new Error('Timeout waiting for device response'));
      }, 2000);

      function handler(event) {
        if (event.reportId === 0x08) {
          clearTimeout(timeout);
          hidDevice.removeEventListener('inputreport', handler);
          const response = new Uint8Array(event.data.buffer);
          resolve(response);
        }
      }
      hidDevice.addEventListener('inputreport', handler);
    });
  }

  async function sendCommand(packet) {
    if (isCommandPending) {
      toast(t('toast_cmd_busy'), 'warn');
      return null;
    }
    isCommandPending = true;
    try {
      const resp = await sendAndReceive(packet);
      return resp;
    } catch (e) {
      console.error('Command failed:', e);
      toast(t('toast_err') + ': ' + (e.message || 'Error'), 'error');
      return null;
    } finally {
      isCommandPending = false;
    }
  }

  // ─── Device Commands ──────────────────────────
  async function readSensorInfo() {
    const pkt = buildPacket(0x03);
    const resp = await sendCommand(pkt);
    if (resp) {
      deviceState.sensorId = Array.from(resp.slice(5, 9)).map(b => b.toString(16).padStart(2, '0')).join('');
    }
    return resp;
  }

  async function readStatus() {
    const pkt = buildPacket(0x04);
    const resp = await sendCommand(pkt);
    if (resp) {
      // In capture evidence: bytes 5-6 are static 0x02 0x64 (NOT current DPI).
      // Byte 9 is battery level percentage.
      const batt = resp[9];
      if (batt > 0 && batt <= 100) {
        deviceState.battery = batt;
      }
      const pollByte = resp[7];
      if (POLL_MAP[pollByte]) {
        deviceState.pollingByte = pollByte;
        deviceState.pollingRate = POLL_MAP[pollByte];
      }

      if (deviceState.pollingRate >= 2000) {
        deviceState.modeSelect = 'corded';
        deviceState.hpMode = false;
      } else if (deviceState.modeSelect === 'corded') {
        deviceState.hpMode = !!deviceState.savedHpMode;
        deviceState.modeSelect = deviceState.hpMode ? 'hp' : 'lp';
      }
    }
    return resp;
  }

  async function readFirmware() {
    const pkt = buildPacket(0x12);
    const resp = await sendCommand(pkt);
    if (resp) {
      deviceState.firmware = resp[5] + '.' + resp[6];
    }
    return resp;
  }

  // DPI stage select (CMD 0x16)
  async function setDPIStage(stageIndex) {
    if (stageIndex < 0 || stageIndex >= DEFAULT_DPI_STAGES.length) return;
    if (stageIndex >= deviceState.dpiStageCount) {
      toast(t('toast_stage_exceeds_count'), 'warn');
      return;
    }

    // Verified CMD 0x16: 08 16 00 00 00 0a [stageIndex] 00 00 00 00 00 00 00 00 [chk]
    const pkt = buildPacket(0x16, 0, 0, 0x00, 0x0A, stageIndex, 0);
    const resp = await sendCommand(pkt);
    if (resp) {
      deviceState.dpiStage = stageIndex;
      deviceState.dpi = DEFAULT_DPI_STAGES[stageIndex].dpi;
      deviceState.dpiSource = 'applied';
      updateUI();
      toast(t('toast_dpi_set') + ' ' + deviceState.dpi + ' DPI (' + t('stage') + ' ' + (stageIndex + 1) + ')', 'success');
    }
  }

  // DPI stage count (CMD 0x14)
  async function setDPIStageCount(count) {
    if (count < 1 || count > 6) return;
    // Verified CMD 0x14: 08 14 00 00 00 0a [count] 00 00 00 00 00 00 00 00 [chk]
    const pkt = buildPacket(0x14, 0, 0, 0x00, 0x0A, count, 0);
    const resp = await sendCommand(pkt);
    if (resp) {
      deviceState.dpiStageCount = count;
      if (deviceState.dpiStage >= count) {
        deviceState.dpiStage = count - 1;
        deviceState.dpi = DEFAULT_DPI_STAGES[deviceState.dpiStage].dpi;
      }
      updateUI();
      toast(t('toast_dpi_stages') + ' ' + count, 'success');
    }
  }

  async function setPollingRate(valHex) {
    const val = typeof valHex === 'string' ? parseInt(valHex, 16) : valHex;
    const pkt = buildSettingPacket(0x00, 0x02, val);
    const resp = await sendCommand(pkt);
    if (resp) {
      deviceState.pollingByte = val;
      deviceState.pollingRate = POLL_MAP[val];

      const isHighRate = deviceState.pollingRate >= 2000;
      if (isHighRate) {
        // Switching to 2000-8000 Hz: lock to Corded mode
        if (deviceState.modeSelect !== 'corded') {
          deviceState.savedHpMode = (deviceState.hpMode === true);
        }
        deviceState.modeSelect = 'corded';
        deviceState.hpMode = false; // Incompatible LP/HP mode must not remain visibly selected
      } else {
        // Returning to <= 1000 Hz: restore user LP/HP selection without uncaptured secondary command
        deviceState.hpMode = !!deviceState.savedHpMode;
        deviceState.modeSelect = deviceState.hpMode ? 'hp' : 'lp';
      }

      updateUI();
      toast(t('toast_poll_set') + ' ' + POLL_MAP[val] + ' Hz', 'success');
      if (isHighRate) {
        toast(t('toast_mode_corded'), 'info');
      }
    }
  }

  async function setPeakPerformance(on) {
    const val = on ? 1 : 0;
    const pkt = buildSettingPacket(0xB5, 0x02, val);
    const resp = await sendCommand(pkt);
    if (resp) {
      deviceState.peakPerformance = on;
      updateUI();
      toast(on ? t('toast_peak_on') : t('toast_peak_off'), 'success');
    }
  }

  async function setPeakDuration(minutes) {
    const val = parseInt(minutes);
    const pkt = buildSettingPacket(0xB7, 0x02, val);
    const resp = await sendCommand(pkt);
    if (resp) {
      deviceState.peakDuration = val;
      updateUI();
      toast(t('toast_peak_dur') + ' ' + val + ' min', 'success');
    }
  }

  async function setHPMode(on) {
    if (deviceState.pollingRate >= 2000) {
      toast(t('toast_mode_locked'), 'error');
      return;
    }
    const val = on ? 1 : 0;
    const pkt = buildSettingPacket(0xB9, 0x02, val);
    const resp = await sendCommand(pkt);
    if (resp) {
      deviceState.hpMode = on;
      deviceState.savedHpMode = on;
      deviceState.modeSelect = on ? 'hp' : 'lp';
      updateUI();
      toast(on ? t('toast_hp_on') : t('toast_hp_off'), 'success');
    }
  }

  async function setDebounce(ms) {
    const val = parseInt(ms);
    const pkt = buildSettingPacket(0xA9, 0x02, val);
    const resp = await sendCommand(pkt);
    if (resp) {
      deviceState.debounce = val;
      updateUI();
      toast(t('toast_debounce') + ' ' + val + ' ms', 'success');
    }
  }

  async function setSensorToggle(reg, on) {
    const val = on ? 1 : 0;
    const pkt = buildSettingPacket(reg, 0x02, val);
    const resp = await sendCommand(pkt);
    if (resp) {
      deviceState.sensorToggles[reg] = on;
      updateUI();
      const names = { 0xB1: 'Motion Sync', 0xAF: 'Ripple Control', 0xAB: 'Angle Snapping' };
      toast(names[reg] + ' ' + (on ? t('toast_toggle_on') : t('toast_toggle_off')), 'success');
    }
  }

  async function setSleepLOD(val) {
    const pkt = buildSettingPacket(0xAD, 0x02, val);
    const resp = await sendCommand(pkt);
    if (resp) {
      deviceState.sleepLod = val;
      updateUI();
      toast('Sleep/LOD set to ' + val, 'success');
    }
  }

  async function selectProfile(idx) {
    const pkt = buildPacket(0x0F, 0, 0, 0x00, 0x01, idx);
    const resp = await sendCommand(pkt);
    if (resp) {
      deviceState.profile = idx;
      updateUI();
      toast(t('toast_profile') + ' ' + (idx + 1), 'success');
    }
  }

  // Button mapping actions
  function selectButton(btnNum) {
    deviceState.selectedButton = btnNum;
    updateUI();
    if (document.getElementById('page-buttons').classList.contains('active')) {
      const el = document.getElementById('button-inspector');
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  function previewButtonAction(val) {
    // Dropdown change
  }

  async function applyButtonRemap() {
    const btnNum = deviceState.selectedButton;
    const def = BUTTON_DEFS[btnNum];
    if (!def || def.locked) {
      toast(t('toast_btn_locked'), 'warn');
      return;
    }

    const sel = document.getElementById('insp-action-select');
    const actionCode = sel.value;
    const byte1 = parseInt(actionCode.substring(0, 2), 16);
    const byte2 = parseInt(actionCode.substring(2, 4), 16);

    const pkt = buildButtonPacket(def.reg, byte1, byte2, 0);
    const resp = await sendCommand(pkt);
    if (resp) {
      deviceState.buttonMapping[btnNum] = actionCode;
      updateUI();
      toast(t('toast_btn_applied') + ' (' + def.name + ' → ' + ACTION_NAMES[actionCode] + ')', 'success');
    }
  }

  function scrollToCard(id) {
    setTimeout(() => {
      const el = document.getElementById(id);
      if (el) el.scrollIntoView({ behavior: 'smooth' });
    }, 100);
  }

  // ─── Connection ───────────────────────────────
  async function connectDevice() {
    if (!('hid' in navigator)) {
      toast(t('toast_no_webhid'), 'error');
      return;
    }
    try {
      const devices = await navigator.hid.requestDevice({
        filters: [
          { vendorId: VID, productId: PID_WIRELESS },
          { vendorId: VID, productId: PID_WIRED },
        ]
      });

      if (!devices || devices.length === 0) {
        toast(t('toast_no_device'), 'error');
        return;
      }

      let device = devices[0];
      for (const d of (Array.isArray(devices) ? devices : [devices])) {
        for (const col of d.collections) {
          if (col.usagePage >= 0xFF00 || col.outputReports?.some(r => r.reportId === 0x08)) {
            device = d;
            break;
          }
        }
      }

      if (!device.opened) {
        await device.open();
      }

      hidDevice = device;

      navigator.hid.addEventListener('disconnect', (e) => {
        if (e.device === hidDevice) {
          hidDevice = null;
          showDisconnected();
          toast(t('toast_disconnected'), 'info');
        }
      });

      await readSensorInfo();
      await readStatus();
      await readFirmware();

      showConnected();
      toast(t('toast_connected'), 'success');
    } catch (e) {
      console.error('Connection failed:', e);
      toast(e.message || 'Connection failed', 'error');
    }
  }

  async function disconnectDevice() {
    if (hidDevice) {
      try { await hidDevice.close(); } catch (e) {}
      hidDevice = null;
    }
    showDisconnected();
    toast(t('toast_disconnected'), 'info');
  }

  // ─── UI State ─────────────────────────────────
  function showConnected() {
    document.getElementById('connect-view').hidden = true;
    document.getElementById('home-view').hidden = false;
    updateUI();
  }

  function showDisconnected() {
    document.getElementById('connect-view').hidden = false;
    document.getElementById('home-view').hidden = true;
  }

  function showPage(name) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    const target = document.getElementById('page-' + name);
    if (target) target.classList.add('active');
    document.querySelectorAll('.nav-item').forEach(n => {
      n.classList.toggle('active', n.dataset.page === name);
    });
    updateUI();
  }

  function updateUI() {
    const s = deviceState;
    const isHighRate = (s.pollingRate >= 2000);

    // Home stats
    document.getElementById('home-dpi').textContent = s.dpi ? s.dpi + ' DPI' : '— DPI';
    document.getElementById('home-poll').textContent = s.pollingRate ? s.pollingRate + ' Hz' : '— Hz';
    document.getElementById('quick-poll-val').textContent = s.pollingRate ? s.pollingRate + ' Hz' : '—';
    const homeModeEl = document.getElementById('home-mode');
    if (homeModeEl) {
      homeModeEl.textContent = isHighRate ? 'Corded' : (s.hpMode ? 'HP' : 'LP');
    }

    // Quick settings: DPI
    const quickDpiSelect = document.getElementById('quick-dpi-select');
    if (quickDpiSelect) {
      quickDpiSelect.value = s.dpiStage;
    }
    const quickDpiSub = document.getElementById('quick-dpi-sub');
    if (quickDpiSub) {
      quickDpiSub.textContent = t('stage') + ' ' + (s.dpiStage + 1) + ' · ' + s.dpi + ' DPI';
    }

    // Quick settings: Polling
    if (s.pollingByte) {
      document.getElementById('quick-poll-select').value = '0x' + s.pollingByte.toString(16).padStart(2, '0');
    }
    document.getElementById('quick-peak').checked = !!s.peakPerformance;

    // Quick Mode Select
    const quickHpInput = document.getElementById('quick-hp');
    const quickHpSwitch = document.getElementById('quick-hp-switch');
    const quickCordedBadge = document.getElementById('quick-corded-badge');
    const quickModeSub = document.getElementById('quick-mode-sub');
    if (quickHpInput && quickCordedBadge && quickHpSwitch) {
      if (isHighRate) {
        quickHpInput.disabled = true;
        quickHpInput.checked = false;
        quickHpSwitch.hidden = true;
        quickCordedBadge.hidden = false;
        if (quickModeSub) quickModeSub.textContent = t('corded_locked_sub');
      } else {
        quickHpInput.disabled = false;
        quickHpInput.checked = !!s.hpMode;
        quickHpSwitch.hidden = false;
        quickCordedBadge.hidden = true;
        if (quickModeSub) quickModeSub.textContent = t('lp_hp_desc');
      }
    }

    // Performance page: DPI configuration
    const perfDpiVal = document.getElementById('perf-dpi-val');
    const perfDpiTag = document.getElementById('perf-dpi-stage-tag');
    if (perfDpiVal) perfDpiVal.textContent = s.dpi + ' DPI';
    if (perfDpiTag) perfDpiTag.textContent = t('stage') + ' ' + (s.dpiStage + 1);

    document.querySelectorAll('#stage-count-buttons .stage-cnt-btn').forEach(btn => {
      btn.classList.toggle('active', parseInt(btn.dataset.count) === s.dpiStageCount);
    });

    document.querySelectorAll('#dpi-stages-grid .dpi-stage-card').forEach(card => {
      const stageIdx = parseInt(card.dataset.stage);
      card.classList.toggle('active', stageIdx === s.dpiStage);
      card.classList.toggle('disabled', stageIdx >= s.dpiStageCount);
    });

    // Performance page Polling buttons
    document.querySelectorAll('#poll-grid .poll-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.val === '0x' + (s.pollingByte || 0).toString(16).padStart(2, '0'));
    });
    document.getElementById('perf-peak').checked = !!s.peakPerformance;
    if (s.peakDuration) document.getElementById('perf-peak-dur').value = s.peakDuration;

    // Performance page Mode Select
    const modeBadge = document.getElementById('mode-active-badge');
    const lockNotice = document.getElementById('mode-lock-notice');
    if (modeBadge) {
      modeBadge.textContent = isHighRate ? 'CORDED' : (s.modeSelect === 'hp' ? 'HP' : 'LP');
      modeBadge.classList.toggle('corded', isHighRate);
    }
    if (lockNotice) {
      lockNotice.hidden = !isHighRate;
    }

    document.querySelectorAll('#mode-toggle .mode-btn').forEach(btn => {
      const mode = btn.dataset.mode;
      if (mode === 'corded') {
        btn.classList.toggle('active', isHighRate);
        btn.classList.toggle('disabled', !isHighRate);
      } else {
        btn.disabled = isHighRate;
        btn.classList.toggle('disabled', isHighRate);
        btn.classList.toggle('active', !isHighRate && s.modeSelect === mode);
      }
    });

    // Sensor page
    document.querySelectorAll('#debounce-grid .poll-btn').forEach(btn => {
      btn.classList.toggle('active', parseInt(btn.dataset.val) === s.debounce);
    });
    document.getElementById('sensor-b1').checked = !!s.sensorToggles[0xB1];
    document.getElementById('sensor-af').checked = !!s.sensorToggles[0xAF];
    document.getElementById('sensor-ab').checked = !!s.sensorToggles[0xAB];
    if (s.sleepLod != null) document.getElementById('sensor-ad').value = s.sleepLod;

    // Button Mapping & Pins
    document.querySelectorAll('.pin').forEach(pin => {
      const btnId = parseInt(pin.dataset.btn);
      pin.classList.toggle('active', btnId === s.selectedButton);
    });

    document.querySelectorAll('#mapping-list .mapping-row').forEach(row => {
      const btnId = parseInt(row.dataset.btn);
      row.classList.toggle('active', btnId === s.selectedButton);
    });

    for (let i = 1; i <= 6; i++) {
      const lbl = document.getElementById('lbl-btn-' + i);
      if (lbl) {
        const actionCode = s.buttonMapping[i];
        lbl.textContent = BUTTON_DEFS[i].name + ' (' + (ACTION_NAMES[actionCode] || actionCode) + ')';
      }
    }

    const def = BUTTON_DEFS[s.selectedButton];
    if (def) {
      document.getElementById('insp-num').textContent = s.selectedButton;
      document.getElementById('insp-name').textContent = def.name;
      const subEl = document.getElementById('insp-sub');
      const badgeEl = document.getElementById('insp-badge');
      const selEl = document.getElementById('insp-action-select');
      const applyBtn = document.getElementById('btn-apply-remap');
      const noteEl = document.getElementById('insp-note');

      if (def.locked) {
        subEl.textContent = t('btn_primary_locked');
        badgeEl.textContent = t('locked');
        badgeEl.className = 'mode-badge';
        selEl.disabled = true;
        selEl.value = '0101';
        applyBtn.disabled = true;
        noteEl.textContent = 'Primary Left Click is locked for safety to prevent losing mouse interaction.';
      } else {
        subEl.textContent = 'Register 0x' + def.reg.toString(16).toUpperCase() + ' · Current: ' + ACTION_NAMES[s.buttonMapping[s.selectedButton]];
        badgeEl.textContent = t('rebindable');
        badgeEl.className = 'mode-badge corded';
        selEl.disabled = false;
        selEl.value = s.buttonMapping[s.selectedButton] || def.defaultAction;
        applyBtn.disabled = false;
        noteEl.textContent = 'Verified hardware register write (CMD 0x07). Echo confirmed by device.';
      }
    }

    // Profiles
    document.querySelectorAll('#profile-cards .profile-card').forEach((card, i) => {
      card.classList.toggle('active', i === s.profile);
      card.querySelector('small').textContent = i === s.profile ? t('active') : 'Profile';
    });
    document.querySelectorAll('#profile-select-grid .profile-big').forEach((card, i) => {
      card.classList.toggle('active', i === s.profile);
    });

    // About page info
    if (s.firmware) {
      document.getElementById('info-fw').textContent = 'v' + s.firmware;
      document.getElementById('fw-label').textContent = 'FW v' + s.firmware;
    }
    if (s.sensorId) document.getElementById('info-sensor').textContent = '0x' + s.sensorId;
    if (hidDevice) {
      document.getElementById('info-pid').textContent = '0x' + hidDevice.productId.toString(16).toUpperCase().padStart(4, '0');
      document.getElementById('info-conn').textContent = hidDevice.productId === PID_WIRELESS ? 'Wireless (2.4 GHz)' : 'Wired USB';
    }

    document.getElementById('status-msg').textContent = t('status_ready');
  }

  // ─── Event Listeners ──────────────────────────
  document.getElementById('connect-button').addEventListener('click', connectDevice);
  document.getElementById('disconnect-btn').addEventListener('click', disconnectDevice);

  document.querySelectorAll('.nav-item').forEach(a => {
    a.addEventListener('click', e => e.preventDefault());
  });

  // Init
  applyLang();
  </script>
</body>
</html>