<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#050505">
  <title>Aria II Pro Configurator</title>
  <link rel="icon" href="assets/fav.ico">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <!-- ═══════════ DISCONNECT / CONNECT SCREEN ═══════════ -->
  <main class="connect-screen" id="connect-view">
    <div class="connect-glass">
      <header class="connect-header">
        <a class="brand" href="#" aria-label="Aria II Pro">
          <img src="assets/aria2banner-readable.webp" alt="Aria II Pro" class="brand-banner-img">
        </a>
        <div class="header-actions">
          <button class="lang-toggle" id="lang-toggle" type="button" aria-label="Language">EN</button>
          <span class="connection-state"><i></i> <span data-i18n="not_connected">DEVICE NOT CONNECTED</span></span>
        </div>
      </header>

      <section class="connect-content">
        <div class="connect-copy">
          <p class="eyebrow" data-i18n="eyebrow">WEB CONFIGURATOR · ARIA II PRO</p>
          <h1 data-i18n="hero_title">Precision.<br><span>Under your control.</span></h1>
          <p class="intro" data-i18n="hero_desc">Connect your Aria II Pro to configure performance, sensor behavior, buttons, macros, and profiles in one focused workspace.</p>
          <button class="connect-button" id="connect-button" type="button">
            <span class="usb-icon">↯</span> <span data-i18n="connect_btn">Connect device</span> <span class="button-arrow">↗</span>
          </button>
          <p class="connect-note" data-i18n="connect_note">USB / Wireless receiver · WebHID-compatible browser required</p>
          <p class="connect-subnote"><span data-i18n="linux_hint">Linux users (Arch / Hyprland): requires udev rule.</span> <a href="docs/linux-setup.md" target="_blank" rel="noopener noreferrer">docs/linux-setup.md ↗</a></p>
        </div>
        <div class="connect-product">
          <div class="product-orbit"></div>
          <img src="assets/front.webp" alt="Fantech Aria II Pro mouse" class="connect-mouse-img" onerror="this.style.display='none';document.getElementById('mouse-fallback').hidden=false">
          <div class="mouse-fallback" id="mouse-fallback" hidden>
            <div class="mouse-placeholder">
              <div class="mouse-shell"></div><div class="mouse-top"></div>
              <div class="mouse-wheel"></div><div class="mouse-led"></div><div class="mouse-side"></div>
            </div>
            <span>Place official product image at <code>assets/mouse1.webp</code></span>
          </div>
          <div class="product-label"><span class="status-dot off"></span><span>ARIA II PRO</span><small>UP TO 8K · SUBJECT TO MODE</small></div>
        </div>
      </section>

      <footer class="connect-footer">
        <span>DESIGNED & BUILT BY <strong>HNXZL</strong></span>
        <span class="made-love" data-i18n="made_love">Made with <span aria-label="love">♥</span> for the community</span>
        <a href="https://tako.id/hnxzl" target="_blank" rel="noopener noreferrer">Support me <span>↗</span></a>
      </footer>
    </div>
    <div class="ambient-label">ARIA II PRO <span>·</span> COMMUNITY CONFIGURATOR</div>
  </main>

  <!-- ═══════════ CONNECTED APP SHELL ═══════════ -->
  <div class="app-shell" id="home-view" hidden>
    <aside class="sidebar">
      <a class="brand" href="#" onclick="showPage('home')" aria-label="Aria II Pro"><img src="assets/aria2banner-readable.webp" alt="Aria II Pro" class="brand-banner-img"></a>
      <nav class="nav" id="nav-menu">
        <a class="nav-item active" href="#" data-page="home" onclick="showPage('home')"><span class="nav-icon">⌂</span><span data-i18n="nav_home">Home</span></a>
        <a class="nav-item" href="#" data-page="performance" onclick="showPage('performance')"><span class="nav-icon">◈</span><span data-i18n="nav_perf">Performance</span></a>
        <a class="nav-item" href="#" data-page="sensor" onclick="showPage('sensor')"><span class="nav-icon">◉</span><span data-i18n="nav_sensor">Sensor Settings</span></a>
        <a class="nav-item" href="#" data-page="buttons" onclick="showPage('buttons')"><span class="nav-icon">⌁</span><span data-i18n="nav_buttons">Button Mapping</span></a>
        <a class="nav-item" href="#" data-page="profiles" onclick="showPage('profiles')"><span class="nav-icon">♧</span><span data-i18n="nav_profiles">Profiles</span></a>
        <a class="nav-item" href="#" data-page="guide" onclick="showPage('guide')"><span class="nav-icon">📖</span><span data-i18n="nav_guide">Feature Guide</span></a>
        <a class="nav-item" href="#" data-page="about" onclick="showPage('about')"><span class="nav-icon">⚙</span><span data-i18n="nav_about">About</span></a>
      </nav>
      <div class="sidebar-footer">
        <span class="status-dot"></span>
        <span data-i18n="device_connected">Device connected</span>
        <button class="disconnect-btn" id="disconnect-btn" type="button" data-i18n="disconnect">Disconnect</button>
      </div>
    </aside>

    <main class="main">
      <header class="windowbar">
        <div class="connection-pill"><span class="status-dot"></span> <span id="connected-label">ARIA II PRO CONNECTED</span></div>
        <div class="windowbar-right">
          <button class="lang-toggle" id="lang-toggle-2" type="button" aria-label="Language">EN</button>
          <span class="fw-label" id="fw-label"></span>
        </div>
      </header>

      <!-- ═══════ PAGE: HOME ═══════ -->
      <div class="page active" id="page-home">
        <div class="dashboard">
          <section class="center-column">
            <div class="hero panel">
              <div class="hero-top">
                <div><img src="assets/aria2banner-readable.webp" alt="Aria II Pro" class="hero-banner-img"></div>
                <div class="transport-toggle" aria-label="Connection mode">
                  <div class="transport active"><span>◉</span><b>8K</b><small>Wireless</small></div>
                </div>
              </div>
              <div class="mouse-stage" id="home-mouse-stage">
                <div class="mouse-halo"></div>
                <div class="mouse-interactive-wrap">
                  <img class="connected-mouse-image" id="home-mouse-img" src="assets/button.webp" alt="Connected Aria II Pro">
                  <button class="pin pin-1 active" type="button" data-btn="1" onclick="selectButton(1)" title="1: Left Button">1</button>
                  <button class="pin pin-2" type="button" data-btn="2" onclick="selectButton(2)" title="2: Right Button">2</button>
                  <button class="pin pin-3" type="button" data-btn="3" onclick="selectButton(3)" title="3: Middle Button">3</button>
                  <button class="pin pin-4" type="button" data-btn="4" onclick="selectButton(4)" title="4: Forward Button">4</button>
                  <button class="pin pin-5" type="button" data-btn="5" onclick="selectButton(5)" title="5: Back Button">5</button>
                  <button class="pin pin-6" type="button" data-btn="6" onclick="selectButton(6)" title="6: DPI Loop">6</button>
                </div>
                <div class="stage-caption"><span class="status-dot"></span> Aria II Pro <span class="muted">· Connected</span></div>
              </div>
            </div>
          </section>
          <aside class="right-column">
            <section class="panel status-panel">
              <div class="section-heading"><h2 data-i18n="device_status">Device Status</h2><span class="live-label">CONNECTED</span></div>
              <div class="device-line"><span class="status-dot"></span><div><strong>Aria II Pro XD7v2P</strong><small data-i18n="wireless_receiver">Wireless Receiver</small></div></div>
              <div class="stat-grid">
                <div class="stat clickable" onclick="showPage('performance'); scrollToCard('dpi-config-card')" title="Configure DPI"><span class="stat-icon">◉</span><div><strong id="home-dpi">1600 DPI</strong><small data-i18n="current_dpi">Current DPI (Stage 3) ↗</small></div></div>
                <div class="stat"><span class="stat-icon">◎</span><div><strong id="home-poll">— Hz</strong><small data-i18n="polling_rate">Polling Rate</small></div></div>
                <div class="stat"><span class="stat-icon">⚡</span><div><strong id="home-mode">LP</strong><small data-i18n="mode_select">Mode Select</small></div></div>
              </div>
            </section>
            <section class="panel quick-panel">
              <div class="section-heading"><h2 data-i18n="quick_settings">Quick Settings</h2></div>
              <div class="setting-row" id="quick-dpi-row">
                <div><strong data-i18n="dpi_stage">DPI Stage</strong><small id="quick-dpi-sub">Stage 3 · 1600 DPI</small></div>
                <select id="quick-dpi-select" onchange="setDPIStage(parseInt(this.value))">
                  <option value="0">Stage 1 (400 DPI)</option>
                  <option value="1">Stage 2 (800 DPI)</option>
                  <option value="2" selected>Stage 3 (1600 DPI)</option>
                  <option value="3">Stage 4 (3200 DPI)</option>
                  <option value="4">Stage 5 (3200 DPI)</option>
                  <option value="5">Stage 6 (6400 DPI)</option>
                </select>
              </div>
              <div class="setting-row">
                <div><strong data-i18n="polling_rate">Polling Rate</strong><small id="quick-poll-val">—</small></div>
                <select id="quick-poll-select" onchange="setPollingRate(this.value)">
                  <option value="0x01">125 Hz</option>
                  <option value="0x02">250 Hz</option>
                  <option value="0x04">500 Hz</option>
                  <option value="0x08">1000 Hz</option>
                  <option value="0x10">2000 Hz</option>
                  <option value="0x20">4000 Hz</option>
                  <option value="0x40">8000 Hz</option>
                </select>
              </div>
              <div class="setting-row">
                <div><strong data-i18n="peak_perf">Peak Performance</strong><small data-i18n="peak_perf_desc">Boost sensor performance</small></div>
                <label class="switch"><input type="checkbox" id="quick-peak" onchange="setPeakPerformance(this.checked)"><span></span></label>
              </div>
              <div class="setting-row" id="quick-mode-row">
                <div><strong data-i18n="mode_select">Mode Select</strong><small id="quick-mode-sub" data-i18n="lp_hp_desc">High Performance vs Low Power</small></div>
                <div id="quick-mode-control" style="display:flex;align-items:center;gap:8px;">
                  <label class="switch" id="quick-hp-switch"><input type="checkbox" id="quick-hp" onchange="setHPMode(this.checked)"><span></span></label>
                  <span class="badge-corded" id="quick-corded-badge" hidden>CORDED</span>
                </div>
              </div>
            </section>
            <section class="panel profiles-panel">
              <div class="section-heading"><h2 data-i18n="profiles">Profiles</h2></div>
              <div class="profile-cards" id="profile-cards">
                <button class="profile-card active" onclick="selectProfile(0)">01<small data-i18n="active">Active</small></button>
                <button class="profile-card" onclick="selectProfile(1)">02<small>Profile</small></button>
                <button class="profile-card" onclick="selectProfile(2)">03<small>Profile</small></button>
              </div>
            </section>
          </aside>
        </div>
      </div>

      <!-- ═══════ PAGE: PERFORMANCE ═══════ -->
      <div class="page" id="page-performance">
        <div class="page-content">
          <h1 class="page-title" data-i18n="nav_perf">Performance</h1>
          <p class="page-desc" data-i18n="perf_desc">Configure polling rate, peak performance, and power mode. All settings are written directly to the device.</p>

          <div class="settings-grid">
            <!-- DPI Stages & Configuration -->
            <section class="panel settings-card" id="dpi-config-card">
              <div class="card-header-flex">
                <div>
                  <h2 data-i18n="dpi_config">DPI Stages & Configuration</h2>
                  <p class="card-desc" data-i18n="dpi_config_desc">Select active DPI stage and set stage count. Stage select (CMD 0x16) and count (CMD 0x14) are hardware-verified.</p>
                </div>
                <div class="dpi-current-pill">
                  <span class="status-dot"></span>
                  <span id="perf-dpi-val">1600 DPI</span>
                  <small id="perf-dpi-stage-tag">Stage 3</small>
                </div>
              </div>

              <div class="dpi-stage-row-label">
                <span data-i18n="active_stages">Active Stages:</span>
                <div class="stage-count-buttons" id="stage-count-buttons">
                  <button type="button" class="stage-cnt-btn" data-count="1" onclick="setDPIStageCount(1)">1</button>
                  <button type="button" class="stage-cnt-btn" data-count="2" onclick="setDPIStageCount(2)">2</button>
                  <button type="button" class="stage-cnt-btn" data-count="3" onclick="setDPIStageCount(3)">3</button>
                  <button type="button" class="stage-cnt-btn" data-count="4" onclick="setDPIStageCount(4)">4</button>
                  <button type="button" class="stage-cnt-btn" data-count="5" onclick="setDPIStageCount(5)">5</button>
                  <button type="button" class="stage-cnt-btn active" data-count="6" onclick="setDPIStageCount(6)">6</button>
                </div>
              </div>

              <div class="dpi-stages-grid" id="dpi-stages-grid">
                <div class="dpi-stage-card" data-stage="0" onclick="setDPIStage(0)">
                  <div class="dpi-stage-top"><span class="dpi-stage-dot" style="background:#ff3333"></span><span>Stage 1</span></div>
                  <strong class="dpi-stage-num">400</strong>
                  <small>DPI</small>
                </div>
                <div class="dpi-stage-card" data-stage="1" onclick="setDPIStage(1)">
                  <div class="dpi-stage-top"><span class="dpi-stage-dot" style="background:#3388ff"></span><span>Stage 2</span></div>
                  <strong class="dpi-stage-num">800</strong>
                  <small>DPI</small>
                </div>
                <div class="dpi-stage-card active" data-stage="2" onclick="setDPIStage(2)">
                  <div class="dpi-stage-top"><span class="dpi-stage-dot" style="background:#00e879"></span><span>Stage 3</span></div>
                  <strong class="dpi-stage-num">1600</strong>
                  <small>DPI</small>
                </div>
                <div class="dpi-stage-card" data-stage="3" onclick="setDPIStage(3)">
                  <div class="dpi-stage-top"><span class="dpi-stage-dot" style="background:#ffd700"></span><span>Stage 4</span></div>
                  <strong class="dpi-stage-num">3200</strong>
                  <small>DPI</small>
                </div>
                <div class="dpi-stage-card" data-stage="4" onclick="setDPIStage(4)">
                  <div class="dpi-stage-top"><span class="dpi-stage-dot" style="background:#00e5ff"></span><span>Stage 5</span></div>
                  <strong class="dpi-stage-num">3200</strong>
                  <small>DPI</small>
                </div>
                <div class="dpi-stage-card" data-stage="5" onclick="setDPIStage(5)">
                  <div class="dpi-stage-top"><span class="dpi-stage-dot" style="background:#b044ff"></span><span>Stage 6</span></div>
                  <strong class="dpi-stage-num">6400</strong>
                  <small>DPI</small>
                </div>
              </div>

              <div class="evidence-tag" data-i18n="evidence_dpi_stage">✓ Active Stage (CMD 0x16) and Stage Count (CMD 0x14) verified in official captures</div>
            </section>

            <section class="panel settings-card">
              <h2 data-i18n="polling_rate">Polling Rate</h2>
              <p class="card-desc" data-i18n="poll_desc">Report rate from mouse to PC. Higher = lower latency, more CPU usage.</p>
              <div class="poll-grid" id="poll-grid">
                <button class="poll-btn" data-val="0x01" onclick="setPollingRate('0x01')">125 Hz<small>8ms</small></button>
                <button class="poll-btn" data-val="0x02" onclick="setPollingRate('0x02')">250 Hz<small>4ms</small></button>
                <button class="poll-btn" data-val="0x04" onclick="setPollingRate('0x04')">500 Hz<small>2ms</small></button>
                <button class="poll-btn" data-val="0x08" onclick="setPollingRate('0x08')">1000 Hz<small>1ms</small></button>
                <button class="poll-btn" data-val="0x10" onclick="setPollingRate('0x10')">2000 Hz<small>0.5ms</small></button>
                <button class="poll-btn" data-val="0x20" onclick="setPollingRate('0x20')">4000 Hz<small>0.25ms</small></button>
                <button class="poll-btn" data-val="0x40" onclick="setPollingRate('0x40')">8000 Hz<small>0.125ms</small></button>
              </div>
              <div class="evidence-tag" data-i18n="evidence_high">✓ Protocol fully decoded from capture evidence</div>
            </section>

            <section class="panel settings-card">
              <h2 data-i18n="peak_perf">Peak Performance</h2>
              <p class="card-desc" data-i18n="peak_desc">Temporarily boost sensor processing. Drains battery faster.</p>
              <div class="setting-row">
                <div><strong data-i18n="enable">Enable</strong></div>
                <label class="switch"><input type="checkbox" id="perf-peak" onchange="setPeakPerformance(this.checked)"><span></span></label>
              </div>
              <div class="setting-row">
                <div><strong data-i18n="peak_duration">Duration</strong><small data-i18n="peak_dur_desc">Auto-disable after this period</small></div>
                <select id="perf-peak-dur" onchange="setPeakDuration(this.value)">
                  <option value="3">3 min</option>
                  <option value="5">5 min</option>
                  <option value="10">10 min</option>
                  <option value="15">15 min</option>
                  <option value="30">30 min</option>
                  <option value="60">60 min</option>
                  <option value="90">90 min</option>
                </select>
              </div>
              <div class="evidence-tag" data-i18n="evidence_high">✓ Protocol fully decoded from capture evidence</div>
            </section>

            <section class="panel settings-card" id="mode-select-card">
              <div class="card-header-flex">
                <div>
                  <h2 data-i18n="mode_select">Mode Select</h2>
                  <p class="card-desc" id="mode-desc" data-i18n="mode_select_desc">Power &amp; tracking profile. 125–1000 Hz supports LP / HP. 2000–8000 Hz operates exclusively in Corded mode.</p>
                </div>
                <span class="mode-badge" id="mode-active-badge">LP</span>
              </div>
              <div class="mode-toggle" id="mode-toggle">
                <button class="mode-btn active" data-mode="lp" onclick="setHPMode(false)" type="button">
                  <span class="mode-icon">🔋</span>
                  <div class="mode-info">
                    <strong data-i18n="low_power">Low Power (LP)</strong>
                    <small data-i18n="lp_detail">Standard tracking · Battery saving (125–1000 Hz)</small>
                  </div>
                </button>
                <button class="mode-btn" data-mode="hp" onclick="setHPMode(true)" type="button">
                  <span class="mode-icon">⚡</span>
                  <div class="mode-info">
                    <strong data-i18n="high_perf">High Performance (HP)</strong>
                    <small data-i18n="hp_detail">Maximum tracking stability (125–1000 Hz)</small>
                  </div>
                </button>
                <div class="mode-btn mode-corded disabled" data-mode="corded" id="btn-corded">
                  <span class="mode-icon">🔌</span>
                  <div class="mode-info">
                    <strong data-i18n="corded_mode">Corded</strong>
                    <small data-i18n="corded_detail">Required for 2000–8000 Hz · Max throughput profile</small>
                  </div>
                </div>
              </div>
              <div class="mode-lock-notice" id="mode-lock-notice" hidden>
                <span class="notice-icon">ℹ</span>
                <span data-i18n="mode_locked_notice">Polling rate is set to 2000–8000 Hz. Device operates in Corded mode; LP/HP selection is disabled.</span>
              </div>
              <div class="evidence-tag" data-i18n="evidence_mode">✓ Mode Select rules verified against official software captures</div>
            </section>
          </div>
        </div>
      </div>

      <!-- ═══════ PAGE: SENSOR ═══════ -->
      <div class="page" id="page-sensor">
        <div class="page-content">
          <h1 class="page-title" data-i18n="nav_sensor">Sensor Settings</h1>
          <p class="page-desc" data-i18n="sensor_desc">Configure debounce filtering and sensor behavior toggles. Toggle register-to-label mapping is based on capture order analysis and may need physical verification.</p>

          <div class="settings-grid">
            <section class="panel settings-card">
              <h2 data-i18n="debounce">Debounce Time</h2>
              <p class="card-desc" data-i18n="debounce_desc">Click filtering delay. Lower = faster response, higher = prevents double-clicks.</p>
              <div class="debounce-grid" id="debounce-grid">
                <button class="poll-btn" data-val="0" onclick="setDebounce(0)">0 ms</button>
                <button class="poll-btn" data-val="1" onclick="setDebounce(1)">1 ms</button>
                <button class="poll-btn" data-val="2" onclick="setDebounce(2)">2 ms</button>
                <button class="poll-btn" data-val="3" onclick="setDebounce(3)">3 ms</button>
                <button class="poll-btn" data-val="4" onclick="setDebounce(4)">4 ms</button>
                <button class="poll-btn" data-val="5" onclick="setDebounce(5)">5 ms</button>
                <button class="poll-btn" data-val="10" onclick="setDebounce(10)">10 ms</button>
                <button class="poll-btn" data-val="15" onclick="setDebounce(15)">15 ms</button>
                <button class="poll-btn" data-val="20" onclick="setDebounce(20)">20 ms</button>
              </div>
              <div class="evidence-tag" data-i18n="evidence_high">✓ Protocol fully decoded from capture evidence</div>
            </section>

            <section class="panel settings-card">
              <h2 data-i18n="sensor_toggles">Sensor Toggles</h2>
              <p class="card-desc" data-i18n="sensor_toggles_desc">Toggle sensor features. Labels are best-effort mapping from capture analysis.</p>
              <div class="setting-row">
                <div><strong data-i18n="motion_sync">Motion Sync</strong><small data-i18n="motion_sync_desc">Synchronize sensor data with polling</small></div>
                <label class="switch"><input type="checkbox" id="sensor-b1" onchange="setSensorToggle(0xB1, this.checked)"><span></span></label>
              </div>
              <div class="setting-row">
                <div><strong data-i18n="ripple_ctrl">Ripple Control</strong><small data-i18n="ripple_desc">Filter sensor ripple/jitter</small></div>
                <label class="switch"><input type="checkbox" id="sensor-af" onchange="setSensorToggle(0xAF, this.checked)"><span></span></label>
              </div>
              <div class="setting-row">
                <div><strong data-i18n="angle_snap">Angle Snapping</strong><small data-i18n="angle_snap_desc">Straighten diagonal movements</small></div>
                <label class="switch"><input type="checkbox" id="sensor-ab" onchange="setSensorToggle(0xAB, this.checked)"><span></span></label>
              </div>
              <div class="evidence-tag warn" data-i18n="evidence_label_uncertain">⚠ Toggles confirmed; label-to-register mapping needs device verification</div>
            </section>

            <section class="panel settings-card">
              <h2 data-i18n="sleep_lod">Sleep / LOD</h2>
              <p class="card-desc" data-i18n="sleep_desc">Register 0xAD02 — purpose not fully determined. Values observed: 1, 30, 60, 210, 240. May be sleep timeout (seconds) or lift-off distance.</p>
              <div class="setting-row">
                <div><strong data-i18n="sleep_value">Value</strong></div>
                <select id="sensor-ad" onchange="setSleepLOD(parseInt(this.value))">
                  <option value="1">1 (shortest / lowest)</option>
                  <option value="30">30</option>
                  <option value="60">60</option>
                  <option value="210">210</option>
                  <option value="240">240 (longest / highest)</option>
                </select>
              </div>
              <div class="evidence-tag warn" data-i18n="evidence_partial">⚠ Register confirmed; value meaning needs device verification</div>
            </section>
          </div>
        </div>
      </div>

      <!-- ═══════ PAGE: BUTTONS ═══════ -->
      <div class="page" id="page-buttons">
        <div class="page-content">
          <h1 class="page-title" data-i18n="nav_buttons">Button Mapping</h1>
          <p class="page-desc" data-i18n="btn_desc">Button mapping protocol partially decoded. Read-only display of current assignments. Full remapping requires further protocol analysis.</p>

          <section class="panel settings-card">
            <div class="mouse-map-area">
              <div class="mouse-interactive-wrap">
                <img class="button-mouse-img" src="assets/button.webp" alt="Mouse button layout">
                <button class="pin pin-1 active" type="button" data-btn="1" onclick="selectButton(1)" title="1: Left Button">1</button>
                <button class="pin pin-2" type="button" data-btn="2" onclick="selectButton(2)" title="2: Right Button">2</button>
                <button class="pin pin-3" type="button" data-btn="3" onclick="selectButton(3)" title="3: Middle Button">3</button>
                <button class="pin pin-4" type="button" data-btn="4" onclick="selectButton(4)" title="4: Forward Button">4</button>
                <button class="pin pin-5" type="button" data-btn="5" onclick="selectButton(5)" title="5: Back Button">5</button>
                <button class="pin pin-6" type="button" data-btn="6" onclick="selectButton(6)" title="6: DPI Loop">6</button>
              </div>
            </div>
            <div class="mapping-grid" id="mapping-list">
              <div class="mapping-row active" data-btn="1" onclick="selectButton(1)"><span class="number">1</span><button class="mapping-button" type="button"><span id="lbl-btn-1" data-i18n="btn_left">Left Button</span> <span class="muted">›</span></button></div>
              <div class="mapping-row" data-btn="4" onclick="selectButton(4)"><span class="number">4</span><button class="mapping-button" type="button"><span id="lbl-btn-4" data-i18n="btn_fwd">Forward</span> <span class="muted">›</span></button></div>
              <div class="mapping-row" data-btn="2" onclick="selectButton(2)"><span class="number">2</span><button class="mapping-button" type="button"><span id="lbl-btn-2" data-i18n="btn_right">Right Button</span> <span class="muted">›</span></button></div>
              <div class="mapping-row" data-btn="5" onclick="selectButton(5)"><span class="number">5</span><button class="mapping-button" type="button"><span id="lbl-btn-5" data-i18n="btn_back">Back</span> <span class="muted">›</span></button></div>
              <div class="mapping-row" data-btn="3" onclick="selectButton(3)"><span class="number">3</span><button class="mapping-button" type="button"><span id="lbl-btn-3" data-i18n="btn_mid">Middle Button</span> <span class="muted">›</span></button></div>
              <div class="mapping-row" data-btn="6" onclick="selectButton(6)"><span class="number">6</span><button class="mapping-button" type="button"><span id="lbl-btn-6" data-i18n="btn_dpi">DPI Loop</span> <span class="muted">›</span></button></div>
            </div>

            <!-- Button Remapping Inspector -->
            <div class="button-inspector-panel" id="button-inspector">
              <div class="inspector-header">
                <div class="inspector-title">
                  <span class="number" id="insp-num">1</span>
                  <div>
                    <strong id="insp-name">Left Button</strong>
                    <small id="insp-sub">Primary Click · Hardware Locked</small>
                  </div>
                </div>
                <span class="mode-badge" id="insp-badge">Locked</span>
              </div>
              <div class="inspector-action-row">
                <label for="insp-action-select" data-i18n="assigned_action">Action:</label>
                <select id="insp-action-select" onchange="previewButtonAction(this.value)">
                  <option value="0101">Left Click (01 01)</option>
                  <option value="0102">Right Click (01 02)</option>
                  <option value="0104">Middle Click (01 04)</option>
                  <option value="0110">Forward (01 10)</option>
                  <option value="0108">Back (01 08)</option>
                  <option value="0500">DPI Loop (05 00)</option>
                  <option value="0000">Disabled (00 00)</option>
                </select>
                <button type="button" class="btn-primary" id="btn-apply-remap" onclick="applyButtonRemap()">Apply Action</button>
              </div>
              <p class="inspector-note" id="insp-note">Primary left click is locked to prevent disabling main click control.</p>
            </div>

            <div class="evidence-tag" data-i18n="evidence_btn">✓ Button registers (0x6404–0x7404) verified from USB captures for basic mouse actions. Keyboard & macros require memory chunks.</div>
          </section>
        </div>
      </div>

      <!-- ═══════ PAGE: PROFILES ═══════ -->
      <div class="page" id="page-profiles">
        <div class="page-content">
          <h1 class="page-title" data-i18n="nav_profiles">Profiles</h1>
          <p class="page-desc" data-i18n="profile_desc">Select between 3 onboard profiles. Each profile stores independent settings.</p>

          <section class="panel settings-card">
            <div class="profile-select-grid" id="profile-select-grid">
              <button class="profile-big active" onclick="selectProfile(0)">
                <span class="profile-num">01</span>
                <span data-i18n="profile">Profile</span> 1
                <small class="profile-active-label" data-i18n="active">Active</small>
              </button>
              <button class="profile-big" onclick="selectProfile(1)">
                <span class="profile-num">02</span>
                <span data-i18n="profile">Profile</span> 2
                <small class="profile-active-label" data-i18n="active">Active</small>
              </button>
              <button class="profile-big" onclick="selectProfile(2)">
                <span class="profile-num">03</span>
                <span data-i18n="profile">Profile</span> 3
                <small class="profile-active-label" data-i18n="active">Active</small>
              </button>
            </div>
            <div class="evidence-tag" data-i18n="evidence_high">✓ Protocol fully decoded from capture evidence</div>
          </section>
        </div>
      </div>

      <!-- ═══════ PAGE: FEATURE GUIDE ═══════ -->
      <div class="page" id="page-guide">
        <div class="page-content guide-content">
          <h1 class="page-title" data-i18n="nav_guide">Feature Guide</h1>
          <p class="page-desc" data-i18n="guide_intro">Complete reference for all configurator features, their protocol status, and what each setting does.</p>

          <div class="guide-grid">
            <article class="guide-card">
              <div class="guide-status confirmed">✓ <span data-i18n="confirmed">Confirmed</span></div>
              <h3 data-i18n="polling_rate">Polling Rate</h3>
              <p data-i18n="guide_poll">Controls how frequently the mouse reports its position to the computer. 125 Hz = every 8ms (lowest latency requirement), 8000 Hz = every 0.125ms (highest responsiveness, highest CPU usage). Uses register 0x0002 with bit-flag encoding. All 7 rates (125–8000 Hz) confirmed in capture evidence.</p>
            </article>
            <article class="guide-card">
              <div class="guide-status confirmed">✓ <span data-i18n="confirmed">Confirmed</span></div>
              <h3 data-i18n="peak_perf">Peak Performance</h3>
              <p data-i18n="guide_peak">Temporarily boosts sensor processing power for competitive play. Increases battery drain. Toggle (register 0xB502) and duration (register 0xB702) both captured. Duration values in the capture: 3 and 90 (likely minutes).</p>
            </article>
            <article class="guide-card">
              <div class="guide-status confirmed">✓ <span data-i18n="confirmed">Confirmed</span></div>
              <h3 data-i18n="lp_hp_mode">Power Mode (LP/HP)</h3>
              <p data-i18n="guide_hp">Switches between Low Power mode (longer battery life) and High Performance mode (better responsiveness). Register 0xB902, value 0=LP, 1=HP. Clean toggle pattern confirmed.</p>
            </article>
            <article class="guide-card">
              <div class="guide-status confirmed">✓ <span data-i18n="confirmed">Confirmed</span></div>
              <h3 data-i18n="debounce">Debounce Time</h3>
              <p data-i18n="guide_debounce">Click filtering delay in milliseconds. Lower values = faster click registration but may cause double-clicks. Higher values = more reliable filtering. Register 0xA902, value is direct milliseconds. Confirmed values: 5ms, 15ms, 20ms.</p>
            </article>
            <article class="guide-card">
              <div class="guide-status partial">⚠ <span data-i18n="partial">Partial</span></div>
              <h3 data-i18n="sensor_toggles">Sensor Toggles</h3>
              <p data-i18n="guide_toggles">Three on/off toggles at registers 0xAB02, 0xAF02, 0xB102. All three confirmed as working toggles (0=off, 1=on). Likely correspond to Motion Sync, Ripple Control, and Angle Snapping from the official software, but the exact register-to-label mapping needs physical device verification.</p>
            </article>
            <article class="guide-card">
              <div class="guide-status partial">⚠ <span data-i18n="partial">Partial</span></div>
              <h3 data-i18n="sleep_lod">Sleep / LOD</h3>
              <p data-i18n="guide_sleep">Register 0xAD02. Values observed: 1, 30, 60, 210, 240. Could be sleep timeout in seconds or lift-off distance. The range of values (1–240) suggests sleep timeout, but physical testing needed to confirm.</p>
            </article>
            <article class="guide-card">
              <div class="guide-status confirmed">✓ <span data-i18n="confirmed">Confirmed</span></div>
              <h3 data-i18n="nav_profiles">Profiles</h3>
              <p data-i18n="guide_profiles">3 onboard profiles selectable via command 0x0F with values 0, 1, 2. Profile memory can be read via command 0x08. Profile switching is clean and confirmed.</p>
            </article>
            <article class="guide-card">
              <div class="guide-status partial">⚠ <span data-i18n="partial">Partial</span></div>
              <h3 data-i18n="nav_buttons">Button Mapping</h3>
              <p data-i18n="guide_buttons">5 configurable button registers at addresses 0x64–0x74 (spacing 4). Action types partially decoded: mouse button (01xx), keyboard key (02xx), macro (040a), DPI cycle (0500), multimedia (0700). Full remapping requires more protocol analysis.</p>
            </article>
            <article class="guide-card">
              <div class="guide-status unverified">◌ <span data-i18n="not_impl">Not Implemented</span></div>
              <h3 data-i18n="macro_mgr">Macro Manager</h3>
              <p data-i18n="guide_macro">Macro data structure partially decoded (name + key sequences with timing). Complex multi-segment write protocol. Not safe to implement without thorough testing.</p>
            </article>
            <article class="guide-card">
              <div class="guide-status partial">⚠ <span data-i18n="partial">Partial</span></div>
              <h3>DPI</h3>
              <p data-i18n="guide_dpi">DPI stage management uses commands 0x14 (write stage count) and 0x16 (select active stage). Current DPI readable from status command 0x04 (byte 6 = DPI encoding). Full DPI value setting protocol needs more capture analysis. DPI byte 0x64 (100) observed — likely 50× or 100× multiplier.</p>
            </article>
          </div>
        </div>
      </div>

      <!-- ═══════ PAGE: ABOUT ═══════ -->
      <div class="page" id="page-about">
        <div class="page-content">
          <h1 class="page-title" data-i18n="nav_about">About</h1>

          <div class="settings-grid">
            <section class="panel settings-card about-card">
              <div class="about-hero">
                <img src="assets/fantech-logo.webp" alt="Fantech" class="about-logo" onerror="this.style.display='none'">
                <div>
                  <h2>Aria II Pro Configurator</h2>
                  <p class="about-sub" data-i18n="about_sub">Independent Community Project</p>
                </div>
              </div>
              <p data-i18n="about_text">This is an independent, open-source web configurator for the Fantech Aria II Pro XD7v2P gaming mouse. It is not developed, endorsed, or affiliated with Fantech in any way. All protocol knowledge was obtained through USB capture analysis of the official software.</p>
              <div class="about-credits">
                <p class="made-love" data-i18n="about_made">Made with ♥ by <strong>HNXZL</strong></p>
                <a class="support-link" href="https://tako.id/hnxzl" target="_blank" rel="noopener noreferrer">Support me ↗</a>
              </div>
            </section>

            <section class="panel settings-card">
              <h2 data-i18n="device_info">Device Information</h2>
              <div class="info-grid" id="device-info-grid">
                <div class="info-row"><span>VID</span><code>0x3554</code></div>
                <div class="info-row"><span>PID</span><code id="info-pid">—</code></div>
                <div class="info-row"><span data-i18n="firmware">Firmware</span><code id="info-fw">—</code></div>
                <div class="info-row"><span data-i18n="sensor_id">Sensor ID</span><code id="info-sensor">—</code></div>
                <div class="info-row"><span data-i18n="interface">Interface</span><code>HID (vendor-specific)</code></div>
                <div class="info-row"><span data-i18n="connection">Connection</span><code id="info-conn">—</code></div>
              </div>
            </section>

            <section class="panel settings-card">
              <h2 data-i18n="linux_support">Linux & WebHID Permissions</h2>
              <p data-i18n="linux_support_desc">On Arch Linux and other systemd distributions, raw HID access requires an active-seat udev rule. HTTPS alone does not grant Linux kernel permissions.</p>
              <pre class="code-block"><code>sudo tee /etc/udev/rules.d/99-fantech-aria-ii-pro.rules &lt;&lt; 'EOF'
ACTION!="remove", SUBSYSTEM=="hidraw", KERNEL=="hidraw*", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f523", MODE="0660", TAG+="uaccess"
ACTION!="remove", SUBSYSTEM=="hidraw", KERNEL=="hidraw*", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f5a5", MODE="0660", TAG+="uaccess"
EOF
sudo udevadm control --reload-rules &amp;&amp; sudo udevadm trigger --subsystem-match=hidraw</code></pre>
              <a class="guide-link-btn" href="docs/linux-setup.md" target="_blank" rel="noopener noreferrer"><span data-i18n="linux_guide_link">View Linux Setup Guide (udev, Flatpak, diagnostics) ↗</span></a>
            </section>

            <section class="panel settings-card">
              <h2 data-i18n="tech_details">Technical Details</h2>
              <p data-i18n="tech_text">Communication uses Interface 1 (49-byte vendor-specific HID). 17-byte packets with checksum = sum mod 256 ≡ 0x55. Value bytes use complement encoding (byte + complement = 0x55). Write commands are echoed back by the device as confirmation.</p>
              <p data-i18n="tech_warning">⚠ This configurator sends real HID commands to your device. While all implemented commands are based on verified capture evidence, use at your own risk. Incorrect settings can be reset by the official Fantech software.</p>
            </section>
          </div>
        </div>
      </div>

      <footer class="app-footer">
        <span>ARIA II PRO · COMMUNITY CONFIGURATOR</span>
        <span id="status-msg" data-i18n="status_ready">Ready</span>
      </footer>
    </main>
  </div>

