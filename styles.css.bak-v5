/* ═══════════════════════════════════════════
   Aria II Pro — layout and design language adapted from the
   Aria XD7 configurator (reference/style.css, unmodified there)
   ═══════════════════════════════════════════ */
*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.help-btn {
  width: 36px;
  height: 36px;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.35);
  color: var(--text-dim);
  font-size: 16px;
  font-weight: 700;
  transition: var(--ease);
}
.help-btn:hover {
  color: var(--accent);
  border-color: rgba(255, 255, 255, 0.55);
  background: var(--accent-soft);
}

:root {
  --glass: linear-gradient(160deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.03));
  --glass-solid: rgba(14, 16, 22, 0.94);
  --line: rgba(255, 255, 255, 0.1);
  --line-strong: rgba(255, 255, 255, 0.18);
  --field: rgba(0, 0, 0, 0.3);
  --hover: rgba(255, 255, 255, 0.07);
  --accent: #ffffff;
  --accent-soft: rgba(255, 255, 255, 0.12);
  --accent-glow: rgba(255, 255, 255, 0.25);
  --text: #f4f6fa;
  --text-dim: #b9c1cf;
  --text-faint: #828b9b;
  --success: #10b981;
  --danger: #ef4444;
  --warn: #f59e0b;
  --bt: #60a5fa;
  --r-win: 20px;
  --r: 10px;
  --ease: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  --stage-scale: 1;
  /* legacy names still used by app.js inline styles */
  --text-main: var(--text);
}
.hero-title {
  max-width: 360px;
  text-align: center;
  font-size: 20px;
  line-height: 1.15;
}

html,
body {
  height: 100%;
}
.help-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  padding-top: 12px;
}
.help-grid div {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 10px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: rgba(0, 0, 0, 0.18);
}
.help-grid .help-wide {
  grid-column: 1 / -1;
}
.help-wide span {
  line-height: 1.45;
}
.help-grid b {
  color: var(--accent);
  font-size: 12px;
}
.help-grid span {
  color: var(--text-dim);
  font-size: 11px;
}
.help-grid small {
  color: var(--text-faint);
  font-size: 10px;
}
[hidden] {
  display: none !important;
}
body {
  background:
    #0d0f14;
  font: 13px/1.4 "Inter", system-ui, sans-serif;
  color: var(--text);
  overflow: hidden;
}
input,
button,
select {
  font: inherit;
  color: inherit;
  outline: none;
}
button {
  cursor: pointer;
}
button:disabled {
  cursor: default;
}
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}
svg {
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}
input[type="number"] {
  -moz-appearance: textfield;
}
input[type="number"]::-webkit-inner-spin-button,
input[type="number"]::-webkit-outer-spin-button {
  display: none;
}

/* ── Canvas ─────────────────────────────────────────────
   Everything sits on a 1560×940 canvas scaled from the window's
   center (app._bindStageScale). Browser zoom only changes the CSS
   viewport, so the canvas rescales and nothing moves. */
.stage {
  position: fixed;
  left: 50%;
  top: 50%;
  width: 1560px;
  height: 940px;
  transform: translate(-50%, -50%) scale(var(--stage-scale));
  display: flex;
  justify-content: center;
  transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
}

.topbar {
  position: absolute;
  top: 22px;
  left: 28px;
  right: 28px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}
.top-logo {
  height: 30px;
  width: auto;
  opacity: 0.9;
  filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.7));
}
.lang-switch {
  display: flex;
  padding: 3px;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid var(--line);
  backdrop-filter: blur(12px);
}
.variant-switch {
  display: flex;
  align-items: center;
  gap: 3px;
  margin-left: auto;
  margin-right: 10px;
  padding: 3px;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid var(--line);
  backdrop-filter: blur(12px);
}
.variant-btn {
  min-width: 48px;
  height: 26px;
  padding: 0 10px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--text-faint);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
  transition: var(--ease);
}
.variant-btn:hover {
  color: var(--text);
}
.variant-btn.active {
  background: var(--accent);
  color: #111;
}
.pro-banner {
  display: block;
  width: clamp(140px, 14vw, 210px);
  height: auto;
  max-width: 210px;
  max-height: 36px;
  object-fit: contain;
  object-position: right center;
  margin-left: 8px;
  filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.55));
}
.pro-banner[hidden] {
  display: none !important;
}
@media (max-width: 720px) {
  .pro-banner {
    width: clamp(110px, 28vw, 170px);
    max-height: 30px;
    margin-left: 4px;
  }
  .variant-switch {
    margin-right: 4px;
  }
}
.lang-switch button {
  min-width: 38px;
  padding: 4px 10px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--text-faint);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
}
.lang-switch button.active {
  background: var(--accent);
  color: #111;
}

/* ── Windows ──────────────────────────────────────────── */
.win {
  position: absolute;
  top: 74px;
  bottom: 76px;
  display: flex;
  flex-direction: column;
  transition:
    opacity 0.6s ease,
    transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1),
    all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
}
/* Two windows, centered as a pair once connected. Before that only the
   mouse window is shown, in the middle of the canvas. */
.win-center {
  left: 538px; /* (1560 - 484) / 2 */
  width: 484px;
  z-index: 2;
}
.win-right {
  left: 789px; /* pair = 484 + 20 + 486 = 990, starting at 285 */
  width: 486px;
}
body.is-connected .win-center {
  transform: translateX(-253px);
}
body:not(.is-connected) .win-right {
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
  transform: translateX(-60px) scale(0.97);
}
body.is-connected .win-right {
  transition-delay: 0.12s;
}

.win-title {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 2.4px;
  text-transform: uppercase;
  color: var(--text-dim);
  margin: 0 0 8px 2px;
  padding: 4px 12px;
  line-height: 1.4;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
}
.panel {
  position: relative;
  flex: 1;
  min-height: 0;
  border-radius: var(--r-win);
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
}
.panel.flash {
  animation: flash 0.9s ease;
}
@keyframes flash {
  30% {
    box-shadow: 0 0 0 2px var(--accent);
  }
}

/* ── Small controls ───────────────────────────────────── */
.btn-sm {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 30px;
  padding: 0 12px;
  border-radius: 8px;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.06);
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
  transition: var(--ease);
}
.btn-sm:hover:not(:disabled) {
  border-color: var(--line-strong);
  background: rgba(255, 255, 255, 0.1);
}
.btn-sm.accent {
  color: var(--accent);
  border-color: rgba(255, 255, 255, 0.35);
  background: var(--accent-soft);
}
.btn-sm.ghost {
  background: transparent;
  color: var(--text-dim);
}
.btn-sm.armed {
  background: var(--danger);
  border-color: var(--danger);
  color: #fff;
}
.btn-sm:disabled {
  opacity: 0.4;
}
.btn-sm svg {
  width: 12px;
  height: 12px;
}
.btn-sm.rec .rec-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--danger);
}
.btn-sm.rec.recording {
  background: rgba(239, 68, 68, 0.18);
  border-color: rgba(239, 68, 68, 0.5);
}
.btn-sm.rec.recording .rec-dot {
  border-radius: 2px;
  animation: pulse 0.9s infinite;
}
@keyframes pulse {
  50% {
    opacity: 0.3;
  }
}

.ic-btn {
  display: inline-grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: var(--text-faint);
  transition: var(--ease);
}
.ic-btn svg {
  width: 15px;
  height: 15px;
}
.ic-btn:hover:not(:disabled) {
  color: var(--text);
  background: var(--hover);
}
.ic-btn.danger:hover:not(:disabled) {
  color: var(--danger);
}
.ic-btn:disabled {
  opacity: 0.3;
}
.ic-btn.spin svg {
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.segmented {
  display: flex;
  padding: 0;
  border-radius: 9px;
  background: var(--field);
  border: 1px solid var(--line);
}
.seg-btn {
  padding: 5px 11px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--text-dim);
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
  transition: var(--ease);
}
.seg-btn:hover {
  color: var(--text);
}
.seg-btn.active {
  background: var(--accent);
  color: #111;
}
.seg-fill .seg-btn {
  flex: 1;
  padding: 5px 0;
}

.stepper {
  display: flex;
  align-items: center;
  border-radius: 9px;
  background: var(--field);
  border: 1px solid var(--line);
}
.stepper button {
  width: 28px;
  height: 28px;
  border: 0;
  background: transparent;
  font-size: 16px;
  line-height: 1;
  border-radius: 7px;
}
.stepper button:hover {
  background: var(--hover);
}
.stepper input {
  width: 46px;
  border: 0;
  background: transparent;
  text-align: center;
  font-weight: 700;
}

.slider-wrap {
  position: relative;
  flex: 1;
  height: 4px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.12);
}
.slider-track {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  border-radius: 2px;
  background: var(--accent);
  pointer-events: none;
}
.slider-wrap input[type="range"],
.dpi-slider-wrap input[type="range"] {
  -webkit-appearance: none;
  appearance: none;
  position: absolute;
  left: 0;
  top: -9px;
  width: 100%;
  height: 22px;
  margin: 0;
  background: transparent;
  cursor: pointer;
}
.slider-wrap input::-webkit-slider-thumb,
.dpi-slider-wrap input::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--accent);
  border: 2px solid #fff;
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
}
.slider-wrap input::-moz-range-thumb,
.dpi-slider-wrap input::-moz-range-thumb {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--accent);
  border: 2px solid #fff;
}

/* ════ Customize (center) ════ */
.panel-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px 14px;
  z-index: 5;
}
.battery {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  font-weight: 700;
  color: var(--text);
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
  opacity: 0;
  transition: opacity 0.5s;
}
.battery.active {
  opacity: 1;
}
.batt-icon {
  width: 30px;
  height: 15px;
  filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.6));
}
.batt-shell {
  fill: rgba(0, 0, 0, 0.3);
  stroke: rgba(255, 255, 255, 0.75);
  stroke-width: 1.4;
}
.batt-tip {
  fill: rgba(255, 255, 255, 0.75);
  stroke: none;
}
.batt-fill {
  fill: var(--success);
  stroke: none;
  transition: width 0.6s ease;
}

.mouse-stage {
  position: relative;
  width: 456px;
  max-width: 100%;
  height: 456px;
  flex-shrink: 0;
  margin-top: 4px;
}
.mouse-render {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  max-width: 100%;
  object-fit: contain;
  filter: drop-shadow(0 26px 36px rgba(0, 0, 0, 0.65));
  user-select: none;
  -webkit-user-drag: none;
  transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.panel-center:not(.connected) .mouse-render {
  transform: scale(0.92) translateY(30px);
}

/* Button labels + leader lines over the render */
.btn-lines,
.btn-pills {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s 0.2s;
}
.btn-lines polyline {
  stroke: rgba(255, 255, 255, 0.4);
  stroke-width: 1;
  vector-effect: non-scaling-stroke;
}
.btn-lines circle {
  fill: var(--accent);
  stroke: rgba(0, 0, 0, 0.6);
  stroke-width: 1;
  vector-effect: non-scaling-stroke;
}
.panel-center.connected .btn-lines,
.panel-center.connected .btn-pills {
  opacity: 1;
}
.panel-center.connected .btn-pills {
  pointer-events: auto;
}
.btn-pill {
  position: absolute;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  width: 124px;
  max-width: 124px;
  padding: 3px 7px;
  border-radius: 8px;
  border: 1px solid var(--line);
  background: rgba(10, 12, 18, 0.7);
  backdrop-filter: blur(8px);
  text-align: left;
  transition: border-color 0.2s, background 0.2s;
}
.btn-pill.side-r {
  text-align: left;
}
.btn-pill:hover,
.btn-pill.open {
  border-color: var(--accent);
  background: rgba(16, 18, 26, 0.92);
}
.pill-name {
  font-size: 8px;
  letter-spacing: 0.65px;
  text-transform: uppercase;
  color: var(--text-faint);
}
.pill-val {
  font-size: 10px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.btn-pill.changed .pill-val {
  color: var(--accent);
}
.btn-pill.is-macro .pill-val {
  color: var(--text-dim);
}
.btn-lines polyline.under {
  stroke-dasharray: 4 3;
}
.btn-pill.side-b {
  transform: translateX(-50%);
  align-items: center;
  text-align: center;
  width: 150px;
  max-width: 150px;
  border-style: dashed;
}
.btn-pill.side-b:hover,
.btn-pill.side-b.open {
  border-style: solid;
}

/* Fantech logo pinned to the bottom of the center window */
.center-logo {
  position: absolute;
  left: 50%;
  bottom: 18px;
  transform: translateX(-50%);
  height: 28px;
  width: auto;
  opacity: 0.85;
  filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.7));
}
.panel-center:not(.connected) .center-logo {
  display: none;
}

.connect-box {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  transition: opacity 0.4s;
}
.panel-center.connected .connect-box {
  display: none;
}
.hero-title {
  font-size: 24px;
  font-weight: 400;
  letter-spacing: 5px;
  line-height: 1;
  text-align: center;
  text-shadow: 0 4px 10px rgba(0, 0, 0, 0.7);
}
.hero-title span {
  display: block;
  font-style: italic;
  font-weight: 300;
  letter-spacing: 4px;
}
.hero-title small {
  display: block;
  margin-top: 8px;
  color: var(--text-dim);
  font-size: 10px;
  font-style: normal;
  font-weight: 600;
  letter-spacing: 4px;
}
.btn-connect {
  padding: 12px 40px;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.5);
  background: var(--accent);
  color: #111;
  font-size: 14px;
  font-weight: 700;
  box-shadow: 0 8px 24px var(--accent-glow);
  transition: var(--ease);
}
.btn-connect:hover:not(:disabled) {
  transform: translateY(-2px);
}
.btn-connect:disabled {
  opacity: 0.7;
}
.btn-connect.hidden {
  display: none;
}

/* Button function picker (over the center window) */
.btn-picker {
  position: absolute;
  inset: 12px;
  z-index: 20;
  display: flex;
  flex-direction: column;
  border-radius: 14px;
  border: 1px solid var(--line-strong);
  background: var(--glass-solid);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  overflow: hidden;
}
.btn-picker[hidden] {
  display: none;
}
.pick-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  border-bottom: 1px solid var(--line);
}
.pick-sub {
  font-size: 10px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--text-faint);
}
.pick-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--accent);
}
.pick-close {
  width: 28px;
  height: 28px;
  border-radius: 7px;
  border: 1px solid var(--line);
  background: transparent;
  font-size: 17px;
}
.pick-body {
  flex: 1;
  overflow-y: auto;
  padding: 8px 16px;
}
.pick-group {
  padding: 8px 0;
  border-bottom: 1px solid var(--line);
}
.pick-group:last-child {
  border-bottom: 0;
}
.pick-label {
  font-size: 10px;
  letter-spacing: 1.4px;
  text-transform: uppercase;
  color: var(--text-faint);
  margin-bottom: 6px;
}
.pick-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}
.pick-chip,
.pick-set,
.pick-reset {
  padding: 5px 10px;
  border-radius: 7px;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.05);
  font-size: 12px;
  transition: var(--ease);
}
.pick-chip:hover,
.pick-set:hover,
.pick-reset:hover {
  border-color: var(--accent);
}
.pick-chip.active,
.pick-set.active {
  background: var(--accent);
  border-color: var(--accent);
  color: #111;
  font-weight: 600;
}
.pick-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 6px;
  font-size: 12px;
  color: var(--text-dim);
}
.pick-row input,
.pick-row select {
  flex: 1;
  min-width: 0;
  padding: 5px 8px;
  border-radius: 7px;
  border: 1px solid var(--line);
  background: var(--field);
  font-size: 12px;
}
.pick-row select option {
  background: #151820;
}
.pick-capture {
  cursor: pointer;
}
.pick-capture:focus {
  border-color: var(--accent);
}
.pick-empty,
.pick-hint {
  font-size: 11.5px;
  color: var(--text-faint);
}
.pick-hint {
  margin-top: 6px;
}
.pick-foot {
  padding: 10px 16px 12px;
  border-top: 1px solid var(--line);
}
.pick-reset {
  width: 100%;
}

/* ════ Performance (right) ════ */
.panel-right {
  display: flex;
  flex-direction: column;
  padding: 8px 16px;
  overflow: hidden;
}
.p-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 44px;
  padding: 7px 0;
  border-bottom: 0;
}
.settings-group {
  margin: 0 0 24px;
  border-top: 0;
}
.settings-group:first-child {
  margin-top: 0;
}
.settings-title {
  padding: 0 0 10px;
  color: var(--text);
  font-size: 11px;
  font-weight: 650;
  letter-spacing: 1.2px;
  text-transform: uppercase;
}
.group-body {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding-bottom: 0;
}
.group-body > .p-row,
.group-body > .compact-pair {
  margin-bottom: 16px;
}
.group-body > :last-child {
  margin-bottom: 0;
}
.compact-pair > .p-row {
  margin-bottom: 16px;
}
.compact-pair > .p-row:last-child {
  margin-bottom: 0;
}
.tab-page + .tab-page .settings-title {
  margin-top: 0;
}
/* SENSOR title sits below the Peak Performance / Long distance checks */
.quick-checks {
  margin-bottom: 0;
}
.quick-checks + .settings-group {
  margin-top: 24px;
}
.compact-pair {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}
.compact-pair .p-row {
  flex: 1 1 160px;
  min-width: 0;
}
.compact-pair .p-label {
  font-size: 12px;
}
.mode-row #modeSelect {
  flex: 1;
  min-width: 0;
}
.mode-row #modeSelect .seg-btn {
  flex: 1;
  min-width: 86px;
  padding-left: 8px;
  padding-right: 8px;
  white-space: nowrap;
}
.quick-checks {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6px 12px;
  padding: 6px 0 2px;
}
.p-row.stack {
  flex-direction: column;
  align-items: stretch;
  gap: 7px;
}
.p-row.slim {
  min-height: 40px;
  border-bottom: 0;
  padding-top: 0;
}
.p-row.checks {
  justify-content: flex-start;
  gap: 6px 12px;
  flex-wrap: wrap;
  margin-top: 0;
}
.receiver-led-select {
  min-width: 220px;
}
.check-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px 16px;
}
.p-label {
  font-size: 13px;
  font-weight: 600;
}
.p-sub {
  width: 80px;
  font-size: 12px;
  color: var(--text-dim);
}
.p-num {
  width: 24px;
  text-align: right;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.p-dpi-head {
  border-bottom: 0;
  padding-bottom: 4px;
}
.dpi-list {
  padding-bottom: 9px;
  border-bottom: 0;
}
.dpi-chips {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 5px;
}
.dpi-chip {
  position: relative;
  height: 34px;
  border-radius: 8px;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.05);
  font-size: 12.5px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  transition: var(--ease);
}
.dpi-chip .chip-dot {
  width: 16px;
  height: 3px;
  border-radius: 2px;
  background: var(--stage-color, #fff);
  box-shadow: 0 0 6px var(--stage-color, #fff);
}
.dpi-chip:hover {
  border-color: var(--line-strong);
}
.dpi-chip.active {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: #fff;
}
.dpi-edit {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 8px;
}
.color-swatch {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  border: 2px solid rgba(255, 255, 255, 0.25);
  flex-shrink: 0;
  transition: var(--ease);
}
.color-swatch:hover {
  transform: scale(1.08);
}
.dpi-slider-wrap {
  position: relative;
  flex: 1;
  height: 4px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.12);
}
.dpi-edit .stepper input {
  width: 58px;
}
.check {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 12.5px;
  color: var(--text-dim);
  cursor: pointer;
}
.check input {
  appearance: none;
  width: 15px;
  height: 15px;
  border-radius: 4px;
  border: 1.5px solid var(--line-strong);
  background: rgba(0, 0, 0, 0.3);
  transition: var(--ease);
}
.check input:checked {
  background: var(--accent);
  border-color: var(--accent);
  box-shadow: inset 0 0 0 2px #1a1a1a;
}
.check input:checked + span {
  color: var(--text);
}

/* ── Status bar (bottom) ─────────────────────────────── */
.statusbar {
  position: absolute;
  left: 28px;
  right: 28px;
  bottom: 22px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}
.firmware-status {
  color: var(--text-faint);
  font-size: 11px;
  white-space: nowrap;
}
.conn-chip {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 30px;
  padding: 0 14px;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid var(--line);
  backdrop-filter: blur(12px);
  font-size: 12px;
  font-weight: 600;
  color: var(--text-dim);
}
.conn-chip .dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--text-faint);
}
.conn-chip.on {
  color: var(--text);
}
.conn-chip.on .dot {
  background: var(--success);
  box-shadow: 0 0 8px var(--success);
}
.conn-chip.bt .dot {
  background: var(--bt);
  box-shadow: 0 0 8px var(--bt);
}
.link-btn {
  height: 30px;
  padding: 0 12px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(12px);
  color: var(--text-dim);
  font-size: 12px;
  font-weight: 600;
}
.link-btn:hover {
  color: var(--text);
}

.fab-container {
  position: absolute;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 7px;
}
/* Profile menu: a labelled button, not a bare icon, so it is easy to find */
.fab-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 36px;
  padding: 0 16px 0 13px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.55);
  background: rgba(14, 16, 22, 0.75);
  backdrop-filter: blur(12px);
  color: var(--accent);
  font-size: 13px;
  font-weight: 700;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
  transition: var(--ease);
}
.fab-btn:hover,
.fab-btn[aria-expanded="true"] {
  background: var(--accent);
  color: #111;
}
.fab-btn svg {
  width: 16px;
  height: 16px;
}
.fab-menu {
  position: absolute;
  right: 0;
  bottom: 48px;
  width: 270px;
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 12px;
  border-radius: 14px;
  background: #14171e;
  border: 1px solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
  opacity: 0;
  transform: translateY(8px);
  pointer-events: none;
  transition: 0.25s ease;
}
.fab-menu.active {
  opacity: 1;
  transform: none;
  pointer-events: auto;
}
.fab-profile {
  font-size: 12.5px;
  color: var(--text-dim);
  padding: 2px 4px 10px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 6px;
}
.fab-profile .editable {
  color: var(--accent);
  font-weight: 700;
  border-bottom: 1px dashed rgba(255, 255, 255, 0.6);
  outline: none;
  padding: 0 2px;
}
.fab-action {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 10px 10px;
  border-radius: 8px;
  border: 0;
  background: transparent;
  color: var(--text);
  font-size: 13.5px;
  font-weight: 600;
  text-align: left;
}
.fab-action:hover {
  background: var(--accent-soft);
  color: var(--accent);
}
.fab-action.danger:hover {
  background: rgba(239, 68, 68, 0.14);
  color: #fca5a5;
}
.fab-action svg {
  width: 17px;
  height: 17px;
  flex-shrink: 0;
}
.fab-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8px;
  padding: 10px 4px 0;
  border-top: 1px solid var(--line);
  font-size: 11.5px;
  color: var(--text-faint);
}
.fab-coffee {
  color: var(--accent);
  font-weight: 600;
  text-decoration: none;
}

/* ── Toast ── */
.toast-area {
  position: absolute;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 999;
  display: flex;
  flex-direction: column;
  gap: 8px;
  pointer-events: none;
}
.toast {
  display: flex;
  align-items: center;
  gap: 10px;
  max-width: 640px;
  padding: 10px 18px;
  border-radius: 10px;
  background: var(--glass-solid);
  border: 1px solid var(--line-strong);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
  font-size: 13px;
  font-weight: 600;
  animation: toastIn 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  transition: opacity 0.3s, transform 0.3s;
}
.toast.toast-out {
  opacity: 0;
  transform: translateY(-12px);
}
.toast svg {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}
@keyframes toastIn {
  from {
    opacity: 0;
    transform: translateY(-12px);
  }
}

/* ── Dialogs (Linux setup, Diagnostics) ── */
.setup-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-items: center;
  padding: 16px;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(6px);
}
.setup-card,
.diag-card {
  width: min(600px, 100%);
  max-height: calc(100vh - 32px);
  overflow: auto;
  padding: 22px;
  border-radius: 14px;
  border: 1px solid var(--line-strong);
  background: #13161d;
  line-height: 1.5;
}
.setup-card h3 {
  margin-bottom: 8px;
  color: var(--accent);
}
.setup-card p,
.setup-card ol {
  margin-bottom: 12px;
  color: var(--text-dim);
}
.setup-card ol {
  padding-left: 20px;
}
.setup-dim {
  font-size: 0.85em;
}
.setup-cmd {
  margin-bottom: 12px;
  padding: 10px 12px;
  border-radius: 8px;
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid var(--line);
  font: 12px/1.5 ui-monospace, monospace;
  white-space: pre-wrap;
  word-break: break-all;
  user-select: all;
}
.setup-actions,
.diag-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}
.setup-actions {
  justify-content: flex-end;
}
.diag-actions {
  margin-top: 10px;
}
.setup-btn {
  padding: 7px 14px;
  border-radius: 8px;
  border: 1px solid var(--accent);
  background: var(--accent);
  color: #111;
  font-size: 12.5px;
  font-weight: 600;
}
.setup-btn.ghost {
  background: transparent;
  color: var(--text);
  border-color: var(--line-strong);
}
.setup-btn:disabled {
  opacity: 0.5;
}

dialog.diag {
  margin: auto;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--text);
  width: 100%;
  max-width: min(760px, calc(100vw - 32px));
}
dialog.diag::backdrop {
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(6px);
}
.diag-card {
  width: 100%;
}
.diag-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}
.diag-head h3 {
  color: var(--accent);
  font-size: 17px;
}
.diag-grid {
  display: grid;
  grid-template-columns: 130px 1fr;
  gap: 5px 14px;
  padding: 12px 14px;
  border-radius: 8px;
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid var(--line);
}
.diag-k {
  color: var(--text-faint);
}
.diag-v {
  font: 12px ui-monospace, monospace;
  word-break: break-word;
}
.diag-label {
  margin: 14px 0 8px;
  color: var(--text-dim);
}
.diag-cands {
  list-style: none;
  font: 12px/1.5 ui-monospace, monospace;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.diag-cands li {
  padding: 6px 10px;
  border-radius: 7px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid transparent;
}
.diag-cands li.current {
  border-color: var(--success);
}
.diag-cands li.dim {
  color: var(--text-faint);
}
.diag-bt {
  margin-top: 14px;
  padding: 12px 14px;
  border-radius: 8px;
  border: 1px solid rgba(96, 165, 250, 0.35);
  background: rgba(96, 165, 250, 0.07);
  color: var(--text-dim);
}
.diag-bt p + p,
.diag-bt pre {
  margin-top: 8px;
}
.diag-bt pre {
  margin-bottom: 0;
}
.diag-bt code,
.diag-dump {
  font: 12px ui-monospace, monospace;
  color: var(--text);
}
.diag-dump {
  color: var(--text-dim);
}
.pill-name {
  white-space: nowrap;
}

/* ═══════════════════════════════════════════════════════════════════
   Aria II Pro adaptation — everything below extends the XD7 reference
   design (glass windows, pills, chips, segmented controls) for the
   Aria II Pro feature set.
   ═══════════════════════════════════════════════════════════════════ */
body {
  background:
    radial-gradient(1200px 700px at 50% 38%, rgba(60, 66, 80, 0.35), transparent 70%),
    url("assets/topography.svg") center / 720px repeat,
    radial-gradient(circle at 50% 120%, #1a1d24, #0b0c10 60%),
    #0b0c10;
}
.topbar {
  justify-content: space-between;
}
.pro-banner {
  width: 210px;
  max-height: 40px;
  object-position: left center;
  margin-left: 0;
}
.top-right {
  display: flex;
  align-items: center;
  gap: 10px;
}
.lang-switch button.active,
.lang-switch button[aria-pressed="true"] {
  background: var(--accent);
  color: #111;
}

/* Two windows: Customize 484 + Settings 560, centred as a pair (248 … 1312). */
.win-right {
  left: 752px;
  width: 560px;
}
body.is-connected .win-center {
  transform: translateX(-290px);
}
body.macros-open .win-center,
body.macros-open .win-right {
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
}
.win-tabs {
  display: flex;
  gap: 4px;
  margin: 0 0 8px 2px;
}
.win-tabs .tab {
  padding: 3px 12px;
  border: 1px solid transparent;
  border-radius: 999px;
  background: transparent;
  font-size: 11.5px;
  font-weight: 600;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  color: var(--text-faint);
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
  transition: var(--ease);
}
.win-tabs .tab:hover {
  color: var(--text);
}
.win-tabs .tab.active {
  color: var(--text-dim);
  border-color: transparent;
  background: transparent;
}
.win-tabs .tab[hidden] {
  display: none;
}
.panel-right {
  overflow-x: hidden;
  overflow-y: auto;
  padding-top: 16px;
  padding-bottom: 42px;
}
.tab-page {
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
  overflow: visible;
  margin: 0 -8px;
  padding: 0 8px;
}
.tab-page[hidden] {
  display: none;
}

/* rows */
.p-labels {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}
.p-hint {
  font-size: 11.5px;
  color: var(--text-faint);
  line-height: 1.4;
}
.p-pad {
  padding: 4px 0 10px;
  border-bottom: 0;
}
.p-row-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.p-value {
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--accent);
}
.p-row.slim.disabled {
  opacity: 0.4;
}
.field,
select.field {
  padding: 6px 10px;
  border-radius: 8px;
  border: 1px solid var(--line);
  background: var(--field);
  font-size: 12.5px;
  font-weight: 600;
}
select.field option,
.pick-row select option {
  background: #151820;
}
select.field:disabled {
  opacity: 0.4;
}
.field.tiny {
  width: 64px;
  padding: 3px 6px;
}
.seg-wrap {
  flex-wrap: wrap;
}
.seg-wrap .seg-btn {
  flex: 1 0 15%;
}
.seg-btn:disabled {
  opacity: 0.35;
  cursor: default;
}
.seg-btn[hidden] {
  display: none;
}
.tag {
  display: inline-block;
  padding: 1px 6px;
  border-radius: 5px;
  border: 1px solid var(--line-strong);
  font-size: 9.5px;
  font-weight: 700;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: var(--text-dim);
  vertical-align: 1px;
  cursor: help;
}
.tag.warn {
  border-color: rgba(245, 158, 11, 0.5);
  color: #fbbf24;
  background: rgba(245, 158, 11, 0.08);
}
.warn-text {
  color: #fbbf24;
}
.danger-text {
  color: #fca5a5 !important;
}
.warn-box {
  padding: 10px 12px;
  border-radius: 8px;
  border: 1px solid rgba(245, 158, 11, 0.4);
  background: rgba(245, 158, 11, 0.07);
  color: #fde68a !important;
}

/* pending = written, waiting for echo + readback */
.pending {
  position: relative;
}
.segmented.pending,
.stepper.pending,
.radio-cards.pending,
.p-row.pending,
select.pending,
.check.pending,
.p-value.pending {
  opacity: 0.6;
  animation: pend 1s ease-in-out infinite;
}
@keyframes pend {
  50% {
    opacity: 0.35;
  }
}
.write-status {
  position: absolute;
  left: 20px;
  right: 20px;
  bottom: 12px;
  font-size: 11.5px;
  color: var(--text-faint);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.write-status.ok {
  display: none;
}
.write-status.err {
  color: #fca5a5;
}
.deb-hint,
#modeHint,
#dpiNote,
#sleepState,
.panel-right .p-hint {
  display: none !important;
}
.receiver-led-label {
  display: none;
}

/* busy overlay (profile switch, import, restore) */
body.is-busy .panel-right,
body.is-busy .btn-pills,
body.is-busy .profile-switch {
  pointer-events: none;
}
body.is-busy .panel-right::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: var(--r-win);
  background: rgba(8, 9, 12, 0.35);
}

/* ── Home window ── */
.mouse-overlay {
  position: absolute;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  z-index: 10;
}
.batt-bolt {
  width: 14px;
  height: 14px;
  fill: var(--accent);
  stroke: none;
}
.profile-switch {
  position: relative;
  display: block;
  padding: 0;
  opacity: 0;
  transition: opacity 0.5s;
}
.panel-center.connected .profile-switch {
  opacity: 1;
}
.profile-trigger {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 6px 10px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--field);
  color: var(--text-dim);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
}
.profile-trigger svg {
  width: 12px;
  height: 12px;
}
.profile-menu {
  position: absolute;
  top: calc(100% + 5px);
  left: 50%;
  display: none;
  min-width: 130px;
  transform: translateX(-50%);
  padding: 4px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--glass-solid);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
}
.profile-switch.open .profile-menu {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.profile-option {
  border: 0;
  border-radius: 6px;
  padding: 6px 9px;
  background: transparent;
  color: var(--text-dim);
  text-align: left;
  font-size: 11px;
}
.profile-option:hover,
.profile-option.active {
  background: var(--accent-soft);
  color: var(--text);
}
.mouse-stage {
  margin-top: 8px;
}
.btn-pill .pill-num {
  display: inline-grid;
  place-items: center;
  width: 10px;
  height: 10px;
  margin-right: 1px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  color: var(--text-dim);
  font-size: 7px;
}
.btn-pill.pending {
  border-color: var(--accent);
  animation: pend 1s ease-in-out infinite;
}
.btn-pill.locked .pill-val {
  color: var(--text-dim);
}
.home-facts {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
  width: 100%;
  padding: 0 6px;
  margin-top: 2px;
}
.panel-center:not(.connected) .home-facts {
  display: none;
}
.fact {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 7px 9px;
  border-radius: 9px;
  background: rgba(0, 0, 0, 0.22);
  border: 1px solid var(--line);
  min-width: 0;
}
.fact span {
  font-size: 9.5px;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: var(--text-faint);
}
.fact b {
  font-size: 12px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hero-subtitle {
  margin-top: -8px;
  color: var(--text-dim);
  letter-spacing: 2px;
}
.hero-note {
  max-width: 340px;
  text-align: center;
  font-size: 11.5px;
  color: var(--text-faint);
}
.center-logo {
  bottom: 14px;
  height: 24px;
}
.pick-current {
  padding: 8px 0;
  font-size: 12px;
  color: var(--text-dim);
  border-bottom: 1px solid var(--line);
}
.pick-current b {
  color: var(--accent);
}

/* ── DPI ── */
.dpi-chip {
  height: 52px;
  gap: 2px;
}
.dpi-chip .chip-stage {
  font-size: 9px;
  letter-spacing: 1px;
  color: var(--text-faint);
}
.dpi-chip.selected {
  border-color: var(--line-strong);
}
.dpi-chip.active {
  border-color: var(--accent);
}
.dpi-chip.active .chip-stage::after {
  content: " ●";
  color: var(--accent);
}
.dpi-chip.draft {
  border-style: dashed;
}
.dpi-chip.pending {
  animation: pend 1s ease-in-out infinite;
}
.dpi-note {
  margin-top: 10px;
  font-size: 11.5px;
  color: var(--text-faint);
  line-height: 1.45;
}

/* ── Sensor ── */
.debounce-grid {
  display: grid;
  grid-template-columns: repeat(11, 1fr);
  gap: 4px;
  transition: opacity 0.2s;
}
.debounce-grid.collapsed {
  opacity: 0.35;
}
.deb-chip {
  height: 26px;
  border-radius: 6px;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.04);
  font-size: 11.5px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.deb-chip.low {
  color: #fcd34d;
}
.deb-chip:hover:not(:disabled) {
  border-color: var(--accent);
}
.deb-chip.active {
  background: var(--accent);
  border-color: var(--accent);
  color: #111;
}
.deb-chip:disabled {
  cursor: default;
}

/* ── Receiver ── */
.radio-cards {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.radio-card {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  padding: 7px 10px;
  border-radius: 9px;
  border: 1px solid var(--line);
  background: rgba(0, 0, 0, 0.2);
  cursor: pointer;
  transition: var(--ease);
}
.radio-card:hover {
  border-color: var(--line-strong);
}
.radio-card.active {
  border-color: var(--accent);
  background: var(--accent-soft);
}
.radio-card input,
.check input[type="radio"] {
  appearance: none;
  flex-shrink: 0;
  width: 14px;
  height: 14px;
  margin-top: 2px;
  border-radius: 50%;
  border: 1.5px solid var(--line-strong);
  background: rgba(0, 0, 0, 0.3);
}
.radio-card input:checked,
.check input[type="radio"]:checked {
  border-color: var(--accent);
  background: var(--accent);
  box-shadow: inset 0 0 0 3px #1a1a1a;
}
.radio-card span {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.radio-card b {
  font-size: 12.5px;
}
.radio-card small {
  font-size: 11px;
  color: var(--text-faint);
  line-height: 1.4;
}

/* ── status bar ── */
.conn-chip.warn .dot {
  background: var(--warn);
  box-shadow: 0 0 8px var(--warn);
}
body:not(.is-connected) #macroBtn {
  display: none;
}

/* ── Macro Manager window ── */
.win-macro {
  left: 248px;
  width: 1064px;
  z-index: 6;
}
.win-macro[hidden] {
  display: none;
}
.macro-title {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.macro-title .pick-close {
  margin: -6px 2px 4px 0;
  color: var(--text);
}
.panel-macro {
  display: grid;
  grid-template-columns: 300px 1fr 300px;
  gap: 0;
  overflow: hidden;
}
.m-col {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-height: 0;
  padding: 16px 18px;
  border-right: 1px solid var(--line);
}
.m-col:last-child {
  border-right: 0;
  overflow-y: auto;
}
.m-head {
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  color: var(--text-dim);
}
.m-head.sub {
  margin-top: 8px;
  padding-top: 10px;
  border-top: 1px solid var(--line);
}
.m-head.row {
  display: flex;
  align-items: center;
  gap: 10px;
  text-transform: none;
  letter-spacing: 0;
}
.m-name {
  flex: 1;
  font-size: 14px;
}
.m-count {
  font-size: 12px;
  font-variant-numeric: tabular-nums;
  color: var(--text-faint);
}
.m-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 4px;
  border-radius: 9px;
  background: rgba(0, 0, 0, 0.22);
  border: 1px solid var(--line);
}
.m-list.short {
  flex: 0 1 auto;
  max-height: 210px;
}
.m-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  padding: 7px 10px;
  border-radius: 7px;
  border: 1px solid transparent;
  background: transparent;
  text-align: left;
}
.m-item span {
  font-weight: 600;
  font-size: 12.5px;
}
.m-item small {
  font-size: 11px;
  color: var(--text-faint);
}
.m-item:not(.static):hover {
  background: var(--hover);
}
.m-item.active {
  border-color: var(--accent);
  background: var(--accent-soft);
}
.m-item.static .btn-sm {
  margin-top: 4px;
  height: 24px;
  font-size: 11px;
}
.m-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
}
.m-dirty {
  font-size: 11.5px;
  color: var(--text-faint);
}
.m-ev {
  display: grid;
  grid-template-columns: 18px 1fr auto auto;
  align-items: center;
  gap: 8px;
  padding: 4px 8px;
  border-radius: 7px;
  border: 1px solid transparent;
  cursor: pointer;
}
.m-ev:hover {
  background: var(--hover);
}
.m-ev.sel {
  border-color: var(--accent);
}
.m-arrow {
  font-weight: 700;
}
.m-arrow.down {
  color: #6ee7b7;
}
.m-arrow.up {
  color: #93c5fd;
}
.m-evname {
  font-size: 12.5px;
  font-weight: 600;
}
.m-delay {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 11.5px;
  color: var(--text-faint);
}
.m-delay svg {
  width: 13px;
  height: 13px;
}
.m-delay input {
  width: 62px;
  padding: 2px 6px;
  border-radius: 6px;
  border: 1px solid var(--line);
  background: var(--field);
  text-align: right;
  font-size: 12px;
}
.m-evbtns {
  display: flex;
}
.m-evbtns .ic-btn {
  width: 22px;
  height: 22px;
  font-size: 10px;
}
.m-pad {
  display: grid;
  place-items: center;
  min-height: 84px;
  padding: 10px;
  border-radius: 9px;
  border: 1px dashed var(--line-strong);
  background: rgba(0, 0, 0, 0.2);
  text-align: center;
  font-size: 11.5px;
  color: var(--text-faint);
  user-select: none;
}
.m-pad.recording {
  border-color: var(--danger);
  color: var(--text);
  background: rgba(239, 68, 68, 0.08);
}
.m-side .check {
  font-size: 12px;
}
.m-side .btn-sm.accent {
  justify-content: center;
  height: 34px;
}

/* ── dialogs ── */
#modalDialog .diag-card {
  max-width: 560px;
  margin: auto;
}
#modalDialog p,
#modalDialog ol {
  margin-bottom: 12px;
  color: var(--text-dim);
}
#modalDialog .check {
  margin: 6px 0 12px;
}
.pair-steps {
  padding-left: 20px;
}
.modal-notes {
  margin: 0 0 12px 18px;
  font-size: 12px;
  color: #fde68a;
}
.modal-progress {
  min-height: 18px;
  margin-bottom: 12px;
  font: 12px ui-monospace, monospace;
  color: var(--text);
}
.setup-btn.danger {
  background: var(--danger);
  border-color: var(--danger);
  color: #fff;
}
.wire-log {
  max-height: 220px;
  overflow: auto;
  user-select: text;
}
.pcr-app {
  z-index: 2000 !important;
}

/* ── layout refinements ── */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  background: radial-gradient(1100px 680px at 50% 40%, rgba(70, 76, 92, 0.28), transparent 70%), rgba(11, 12, 16, 0.72);
  pointer-events: none;
}
.pro-banner {
  filter: brightness(0) invert(1) drop-shadow(0 2px 6px rgba(0, 0, 0, 0.6));
  opacity: 0.92;
}
.mouse-stage {
  width: 420px;
  height: 400px;
  margin-top: 0;
}
.panel-center {
  padding: 16px 14px 46px;
}
.panel-right .p-row {
  min-height: 0;
  padding: 0;
}
.panel-right .p-row.slim {
  min-height: 0;
  padding: 0;
}
.panel-right .dpi-list {
  padding-bottom: 0;
  margin-bottom: 16px;
}
.home-debounce {
  width: 100%;
  margin-top: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid var(--line);
  background: rgba(0, 0, 0, 0.18);
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.panel-center:not(.connected) .home-debounce {
  display: none;
}
.home-debounce .deb-chip {
  height: 24px;
  font-size: 11px;
}
#receiverSection[hidden] {
  display: none;
}
.m-actions .btn-sm {
  padding: 0 10px;
}
.btn-sm.danger-btn:hover {
  color: #fca5a5;
  border-color: rgba(239, 68, 68, 0.5);
}
body:not(.is-connected) .fab-container {
  display: none;
}

/* ═══ Customize panel v2: mouse → 2×2 status → debounce ═══ */
.mouse-stage {
  height: 372px;
}
.home-facts,
.fact {
  display: none;
}
.status-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  width: 100%;
  margin-top: 4px;
}
.panel-center:not(.connected) .status-grid {
  display: none;
}
.stat-card {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  min-height: 58px;
  padding: 9px 12px;
  border-radius: 10px;
  border: 1px solid var(--line);
  background: rgba(0, 0, 0, 0.22);
}
.stat-ic {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  color: var(--text-faint);
  stroke-width: 1.7;
}
.stat-txt {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.stat-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: var(--text-faint);
}
.stat-label i {
  font-style: normal;
  color: var(--accent);
  letter-spacing: 0.6px;
}
.stat-val {
  font-size: 14px;
  font-weight: 700;
  line-height: 1.25;
  overflow-wrap: anywhere;
}
.stat-val small {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-dim);
  white-space: nowrap;
}
.stat-card.busy {
  border-color: rgba(255, 255, 255, 0.45);
}
.stat-card.busy .stat-val {
  animation: pend 1s ease-in-out infinite;
}
.stat-card.dim .stat-val {
  color: var(--text-faint);
  font-weight: 600;
}

.home-debounce {
  margin-top: 8px;
  padding: 10px 12px;
  gap: 6px;
}
.deb-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.deb-labels {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}
.deb-title {
  font-size: 13px;
  font-weight: 600;
}
.deb-gate {
  font-size: 11.5px;
  margin-left: 0;
}
.deb-stepper {
  flex-shrink: 0;
}
.deb-stepper button {
  width: 32px;
  height: 32px;
}
.deb-stepper input {
  width: 40px;
  padding: 0;
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.deb-unit {
  padding: 0 6px 0 3px;
  font-size: 12px;
  color: var(--text-faint);
}
.deb-stepper.disabled {
  opacity: 0.45;
}
.deb-stepper button:disabled {
  cursor: default;
  opacity: 0.4;
}
.deb-stepper.draft {
  border-color: rgba(255, 255, 255, 0.6);
  border-style: dashed;
}
.deb-stepper.invalid {
  border-color: var(--danger);
}
.deb-hint {
  min-height: 15px;
}
.sleep-select {
  min-width: 140px;
  flex-shrink: 0;
}
.field-state {
  font-variant-numeric: tabular-nums;
}

/* ═══ Narrow windows: stack and scroll instead of shrinking the canvas ═══ */
body.narrow {
  overflow-y: auto;
}
body.narrow .stage {
  position: relative;
  left: auto;
  top: auto;
  width: 100%;
  height: auto;
  transform: none;
  padding: 72px 12px 84px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}
body.narrow .topbar {
  top: 16px;
  left: 16px;
  right: 16px;
}
body.narrow .pro-banner {
  width: 160px;
}
body.narrow .win,
body.narrow .win-right,
body.narrow .win-macro {
  position: relative;
  left: auto;
  top: auto;
  bottom: auto;
  width: min(560px, 100%);
  transform: none !important;
}
body.narrow .win-center .panel {
  min-height: 600px;
}
body.narrow:not(.is-connected) .win-right {
  display: none;
}
body.narrow .win-right .panel {
  min-height: 640px;
}
body.narrow .win-macro .panel-macro {
  grid-template-columns: 1fr;
}
body.narrow .win-macro .m-col {
  border-right: 0;
  border-bottom: 1px solid var(--line);
}
body.narrow .win-macro .m-list {
  min-height: 160px;
}
body.narrow .statusbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: auto;
  padding: 10px 12px;
  flex-wrap: wrap;
  background: rgba(11, 12, 16, 0.92);
  border-top: 1px solid var(--line);
  z-index: 50;
}
body.narrow .fab-container {
  position: relative;
}
body.narrow .mouse-stage {
  width: min(420px, 100%);
}
@media (max-width: 420px) {
  .status-grid {
    gap: 6px;
  }
  .stat-card {
    padding: 8px 10px;
  }
  .stat-ic {
    display: none;
  }
}
.mouse-stage {
  width: 456px;
  height: 400px;
}
body.narrow .mouse-stage {
  width: 456px;
}
@media (max-width: 520px) {
  /* Keep the callouts legible on phones: shrink the whole illustration
     (image, lines and pills together) instead of letting pills collide. */
  body.narrow .mouse-stage {
    width: 456px;
    zoom: 0.74;
  }
  body.narrow .stage {
    padding-bottom: 130px;
  }
}

/* ═══ Compact status + debounce (v3, minimal) ═══ */
.status-grid {
  gap: 6px;
  margin-top: 2px;
}
.stat-card {
  gap: 8px;
  min-height: 44px;
  padding: 6px 10px;
  border-radius: 8px;
  background: rgba(0, 0, 0, 0.16);
}
.stat-ic {
  width: 14px;
  height: 14px;
}
.stat-label {
  font-size: 9px;
  letter-spacing: 1px;
}
.stat-val {
  font-size: 12.5px;
  line-height: 1.2;
}
.stat-val small {
  font-size: 11px;
}
.home-debounce {
  margin-top: 6px;
  padding: 6px 10px;
  gap: 4px;
  border-radius: 8px;
  background: rgba(0, 0, 0, 0.16);
}
.deb-main {
  gap: 10px;
}
.deb-title {
  font-size: 12.5px;
  margin-right: auto;
}
.deb-gate {
  font-size: 11.5px;
}
.deb-stepper button {
  width: 26px;
  height: 26px;
  font-size: 15px;
}
.deb-stepper input {
  width: 30px;
  font-size: 12.5px;
}
.deb-unit {
  font-size: 11px;
  padding: 0 4px 0 2px;
}
.deb-hint {
  font-size: 11px;
  min-height: 0;
}
.deb-hint[hidden] {
  display: none;
}
body.is-asleep .panel-right,
body.is-asleep .btn-pills,
body.is-asleep .profile-switch,
body.is-asleep .home-debounce {
  opacity: 0.55;
  pointer-events: none;
}

/* ═══ Three-column connected layout (v4): Macro Manager | mouse | settings ═══
   Canvas 1560 wide: left 30–480, centre 500–984, right 1004–1530. Before a
   mouse is connected only the centre window is shown, centred. */
.panel-layout {
  position: absolute;
  inset: 74px 0 76px;
  padding-left: 40px;
  padding-right: 40px;
  display: flex;
  justify-content: center;
  align-items: stretch;
  gap: 24px;
  transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
}
.panel-layout .win {
  position: relative;
  inset: auto;
  top: auto;
  bottom: auto;
  left: auto;
  width: auto;
  flex: 1 1 0;
  min-width: 380px;
  transform: none;
  transition: width 0.4s ease, transform 0.4s ease, opacity 0.4s ease;
}
.panel-layout .win-center {
  order: 2;
}
/* the old two-window translateX(-290px) outranked .panel-layout .win and
   pushed the Customize window (and its title) off the left edge */
body.is-connected .panel-layout .win-center,
body.is-connected .panel-layout .win-right {
  transform: none;
}
.panel-layout .win-right {
  order: 3;
}
.win-left {
  order: 1;
  width: 400px;
  z-index: 1;
}
.panel-layout:not(.is-macro-open) .win-left,
body:not(.is-connected) .win-left {
  display: none;
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
  transform: translateX(-60px) scale(0.97);
}
.panel-layout.is-macro-open .win {
  width: auto;
  flex-basis: 0;
}
.panel-layout.is-macro-open .win-left {
  display: flex;
  opacity: 1;
  pointer-events: auto;
  visibility: visible;
  transform: translateX(0);
}
.panel-layout.is-macro-open .win-center,
.panel-layout.is-macro-open .win-right {
  opacity: 1;
  pointer-events: auto;
  visibility: visible;
  transform: none;
}
.panel-macro {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 4px 0;
  overflow: hidden;
}
.m-sec {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 10px 16px;
  border-bottom: 1px solid var(--line);
  min-height: 0;
}
.m-sec:last-child {
  border-bottom: 0;
}
.m-sec.grow {
  flex: 1;
}
.m-head.row {
  justify-content: space-between;
}
.m-tools {
  display: flex;
  gap: 4px;
}
.m-tools .btn-sm,
.m-sec .btn-sm {
  height: 26px;
  padding: 0 9px;
  font-size: 11.5px;
}
.m-list.lib {
  flex: 0 0 auto;
  max-height: 104px;
}
.m-list.lib .m-item {
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  padding: 5px 9px;
}
.m-list.events {
  flex: 1;
  min-height: 120px;
}
.m-list.short {
  max-height: 96px;
}
.m-row {
  display: flex;
  align-items: center;
  gap: 6px;
}
.m-row .field {
  min-width: 0;
  padding: 5px 8px;
  font-size: 12px;
}
.m-row select.field {
  flex: 1;
}
.m-unit {
  font-size: 11.5px;
  color: var(--text-faint);
}
.btn-sm.wide {
  flex: 1;
  justify-content: center;
  height: 30px !important;
}
.m-pad {
  min-height: 52px;
}
.m-pad[hidden] {
  display: none;
}
.m-note {
  margin: 0;
  font-size: 11px;
}
.m-dirty:empty {
  display: none;
}
.m-ev {
  padding: 3px 6px;
}

@media (max-width: 1400px) {
  body:not(.narrow) .panel-layout {
    transform: scale(0.9);
    transform-origin: center top;
  }
}

/* Status grid and debounce sit at the bottom of the mouse window,
   leaving air under the illustration. */
.status-grid {
  margin-top: auto;
}
.panel-center {
  padding-bottom: 50px;
}
.home-debounce {
  margin-top: 8px;
}

/* narrow: stack centre, settings, macros */
body.narrow .win-left {
  order: 3;
  left: auto;
  width: min(560px, 100%);
}
body.narrow .win-center {
  order: 1;
}
body.narrow .win-right {
  order: 2;
}
body.narrow:not(.is-connected) .win-left {
  display: none;
}
body.narrow .win-left .panel {
  min-height: 720px;
}
#mButton {
  flex: 0 0 150px;
}
#mMode {
  flex: 1 1 auto;
}
.m-sec .m-head.row {
  font-size: 10.5px;
}
